// wld-data-v1 — схема: все таблицы со всеми полями, группы — рамками.
// Сгенерировано из описания схемы; руками не править. Картинка (SVG): tools/schema-svg.sh wld.
digraph schema {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.9, pad=0.3, splines=true, newrank=true];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [dir=both, arrowtail=none, arrowhead=crow, arrowsize=0.9, color="#333333"];
  subgraph "cluster_world" {
    label=<<B>Мир</B>>;
    style="rounded,filled"; fillcolor="#ececec"; color="#bbbbbb"; margin=14;
    "countries" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>countries</B><BR/>Страны</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="code"><FONT FACE="DejaVu Sans Mono"># </FONT>code</TD></TR><TR><TD ALIGN="LEFT" PORT="code2"><FONT FACE="DejaVu Sans Mono">∗ </FONT>code2</TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name</TD></TR><TR><TD ALIGN="LEFT" PORT="name_ru"><FONT FACE="DejaVu Sans Mono">○ </FONT>name_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="local_name"><FONT FACE="DejaVu Sans Mono">○ </FONT>local_name</TD></TR><TR><TD ALIGN="LEFT" PORT="continent"><FONT FACE="DejaVu Sans Mono">∗ </FONT>continent</TD></TR><TR><TD ALIGN="LEFT" PORT="region"><FONT FACE="DejaVu Sans Mono">○ </FONT>region</TD></TR><TR><TD ALIGN="LEFT" PORT="region_ru"><FONT FACE="DejaVu Sans Mono">○ </FONT>region_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="surface_area"><FONT FACE="DejaVu Sans Mono">○ </FONT>surface_area</TD></TR><TR><TD ALIGN="LEFT" PORT="population"><FONT FACE="DejaVu Sans Mono">○ </FONT>population</TD></TR><TR><TD ALIGN="LEFT" PORT="life_expectancy"><FONT FACE="DejaVu Sans Mono">○ </FONT>life_expectancy</TD></TR><TR><TD ALIGN="LEFT" PORT="gnp"><FONT FACE="DejaVu Sans Mono">○ </FONT>gnp</TD></TR><TR><TD ALIGN="LEFT" PORT="gnp_old"><FONT FACE="DejaVu Sans Mono">○ </FONT>gnp_old</TD></TR><TR><TD ALIGN="LEFT" PORT="capital"><FONT FACE="DejaVu Sans Mono">○ </FONT>capital</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "cities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>cities</B><BR/>Города</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name</TD></TR><TR><TD ALIGN="LEFT" PORT="name_ru"><FONT FACE="DejaVu Sans Mono">○ </FONT>name_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="country_code"><FONT FACE="DejaVu Sans Mono">∗ </FONT>country_code</TD></TR><TR><TD ALIGN="LEFT" PORT="district"><FONT FACE="DejaVu Sans Mono">○ </FONT>district</TD></TR><TR><TD ALIGN="LEFT" PORT="population"><FONT FACE="DejaVu Sans Mono">∗ </FONT>population</TD></TR><TR><TD ALIGN="LEFT" PORT="latitude"><FONT FACE="DejaVu Sans Mono">∗ </FONT>latitude</TD></TR><TR><TD ALIGN="LEFT" PORT="longitude"><FONT FACE="DejaVu Sans Mono">∗ </FONT>longitude</TD></TR><TR><TD ALIGN="LEFT" PORT="timezone"><FONT FACE="DejaVu Sans Mono">○ </FONT>timezone</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "country_languages" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>country_languages</B><BR/>Языки стран</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="country_code"><FONT FACE="DejaVu Sans Mono"># </FONT>country_code</TD></TR><TR><TD ALIGN="LEFT" PORT="language_code"><FONT FACE="DejaVu Sans Mono"># </FONT>language_code</TD></TR><TR><TD ALIGN="LEFT" PORT="language"><FONT FACE="DejaVu Sans Mono">∗ </FONT>language</TD></TR><TR><TD ALIGN="LEFT" PORT="language_ru"><FONT FACE="DejaVu Sans Mono">○ </FONT>language_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="official"><FONT FACE="DejaVu Sans Mono">∗ </FONT>official</TD></TR><TR><TD ALIGN="LEFT" PORT="percentage"><FONT FACE="DejaVu Sans Mono">∗ </FONT>percentage</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "country_borders" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>country_borders</B><BR/>Соседство стран</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="country_code"><FONT FACE="DejaVu Sans Mono"># </FONT>country_code</TD></TR><TR><TD ALIGN="LEFT" PORT="neighbour_code"><FONT FACE="DejaVu Sans Mono"># </FONT>neighbour_code</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "country_years" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>country_years</B><BR/>Страны по годам</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="country_code"><FONT FACE="DejaVu Sans Mono"># </FONT>country_code</TD></TR><TR><TD ALIGN="LEFT" PORT="year"><FONT FACE="DejaVu Sans Mono"># </FONT>year</TD></TR><TR><TD ALIGN="LEFT" PORT="population"><FONT FACE="DejaVu Sans Mono">○ </FONT>population</TD></TR><TR><TD ALIGN="LEFT" PORT="gnp"><FONT FACE="DejaVu Sans Mono">○ </FONT>gnp</TD></TR><TR><TD ALIGN="LEFT" PORT="gdp"><FONT FACE="DejaVu Sans Mono">○ </FONT>gdp</TD></TR><TR><TD ALIGN="LEFT" PORT="life_expectancy"><FONT FACE="DejaVu Sans Mono">○ </FONT>life_expectancy</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
  }
  "cities":"id" -> "countries":"capital" [style=dashed];
  "countries":"code" -> "cities":"country_code";
  "countries":"code" -> "country_languages":"country_code";
  "countries":"code" -> "country_borders":"country_code";
  "countries":"code" -> "country_borders":"neighbour_code";
  "countries":"code" -> "country_years":"country_code";
}
