%% sto-data-v1 — ER-диаграмма; сгенерировано из описания схемы
erDiagram
    categories {
        int id PK "Категория"
        int parent_id FK "Родительская категория; NULL — корень"
        smallint level "Уровень: 1 — корень, 6 — самый глубокий"
        text name_ru "Название по-русски"
        text name_en "Название по-английски"
    }
    spec_keys {
        text key PK "Код характеристики"
        text name_ru "Название по-русски"
        text name_en "Название по-английски"
        text unit "Единица (латиницей: in, GB, W, mAh…); NULL — без единицы"
        text value_type "Тип значения"
    }
    brands {
        int id PK "Бренд"
        text name "Название (латиницей)"
        text origin_country "Страна бренда, код ISO 3166-1 alpha-2"
        text tier "Ценовой уровень"
        bool is_private_label "Собственная марка магазина"
    }
    products {
        int id PK "Товар"
        text sku "Артикул магазина"
        text ean13 "Штрихкод EAN-13 (у комплектов — внутренний, префикс 2)"
        int brand_id FK "Бренд"
        int category_id FK "Категория — лист дерева"
        text name_ru "Название по-русски"
        text name_en "Название по-английски"
        text model_line "Модельная линейка"
        smallint generation "Поколение модели в линейке: 1, 2, …"
        date launched_on "Начало продаж"
        date discontinued_on "Снят с продажи; NULL — продаётся до конца периода"
        int weight_g "Вес в упаковке, г"
        int length_mm "Длина упаковки, мм"
        int width_mm "Ширина упаковки, мм"
        int height_mm "Высота упаковки, мм"
        smallint warranty_months "Гарантия, месяцев"
        bool is_bundle "Комплект (состав — в bundle_items)"
    }
    product_specs {
        int product_id PK, FK "Товар"
        text key PK, FK "Характеристика"
        text value_text "Текстовое значение"
        decimal value_num "Числовое значение"
        text unit "Единица числового значения (как в spec_keys)"
    }
    bundle_items {
        int bundle_id PK, FK "Комплект"
        int component_id PK, FK "Составная часть — товар или комплект"
        smallint qty "Штук в комплекте"
    }
    prices {
        int product_id PK, FK "Товар"
        moment valid_from PK "Цена действует с (включительно)"
        moment valid_to "Цена действует по (исключая); NULL — без конца в периоде"
        money price "Цена с НДС, руб."
    }
    promotions {
        int id PK "Акция"
        text kind "Механика"
        text name_ru "Название по-русски"
        text name_en "Название по-английски"
        text event "Торговое событие календаря; NULL — обычная акция"
        decimal discount_pct "Скидка, % (percent, bundle, promocode в процентах)"
        money discount_amount "Скидка, руб. (amount — с единицы товара; promocode без целей — с заказа)"
        smallint buy_qty "n+m: сколько купить"
        smallint free_qty "n+m: сколько из них бесплатно (самые дешёвые)"
        text promo_code "Промокод (только promocode)"
        money min_order_amount "Минимальная сумма заказа"
        moment valid_from "Начало (включительно)"
        moment valid_to "Конец (исключая)"
        bool stackable "Суммируется с другими суммируемыми акциями"
    }
    promotion_targets {
        int promo_id PK, FK "Акция"
        int seq PK "Номер цели в акции: 1, 2, …"
        int product_id FK "Товар"
        int category_id FK "Категория (действует на всё поддерево)"
    }
    cities {
        int id PK "Город"
        text name_ru "Название по-русски"
        text name_en "Название по-английски (опечатки источника исправлены)"
        text region_ru "Субъект РФ по-русски"
        text region_en "Субъект РФ по-английски"
        text federal_district "Федеральный округ"
        double lat "Широта центра (среднее аэропортов города)"
        double lon "Долгота центра (среднее аэропортов города)"
        text timezone "Часовой пояс IANA"
        int population "Население, человек — оценка, округлено"
        text airport_code "Главный аэропорт города — ключ к air-data-v1 airports"
    }
    warehouses {
        int id PK "Склад или пункт выдачи"
        int parent_id FK "Кто снабжает; NULL — хаб"
        text kind "Вид"
        text code "Код"
        text name_ru "Название по-русски"
        text name_en "Название по-английски"
        int city_id FK "Город"
        double lat "Широта"
        double lon "Долгота"
        date opened_on "Открыт"
        date closed_on "Закрыт; NULL — работает"
    }
    storage_cells {
        int id PK "Ячейка"
        int warehouse_id FK "Склад"
        text zone "Зона хранения"
        text code "Адрес ячейки: зона-стеллаж-полка-ячейка"
        smallint rack "Стеллаж"
        smallint shelf "Полка (ярус), 1 — нижняя"
        smallint cell "Ячейка на полке"
        int max_weight_kg "Предельный вес, кг"
        int max_volume_l "Предельный объём, л"
    }
    carriers {
        int id PK "Перевозчик"
        text name_ru "Название по-русски"
        text name_en "Название по-английски"
        text kind "Вид"
    }
    delivery_zones {
        int id PK "Зона"
        int warehouse_id FK "Склад отгрузки"
        int carrier_id FK "Перевозчик"
        smallint ring "Пояс: 0 — ближний, дальше — дальше"
        text polygon "Многоугольник WKT POLYGON((lon lat, …)), против часовой стрелки"
        smallint base_days "Базовый срок доставки, дней"
    }
    suppliers {
        int id PK "Поставщик"
        text name_ru "Название по-русски"
        text name_en "Название по-английски"
        text kind "Вид"
        int city_id FK "Город"
        smallint lead_time_days "Обычный срок поставки, дней"
        decimal reliability "Доля поставок в срок, 0–1"
    }
    purchase_orders {
        int id PK "Заказ поставщику"
        int supplier_id FK "Поставщик"
        int warehouse_id FK "Склад приёмки (хаб или РЦ)"
        moment ordered_at "Размещён"
        moment expected_at "Ожидается"
        moment received_at "Принят; NULL — не принят"
        text status "Статус"
        text purpose "Назначение: входящий остаток на начало периода (на любой склад, даты = начало), первая поставка товара на склад (новинки), пополнение"
    }
    batches {
        int id PK "Партия"
        int po_id FK "Заказ поставщику; NULL — партия продавца"
        int seller_id FK "Продавец FBO; NULL — партия магазина"
        int product_id FK "Товар"
        int warehouse_id FK "Склад приёмки"
        int qty "Штук"
        money unit_cost "Закупочная цена за штуку без НДС, руб."
        moment received_at "Принята; NULL — в пути"
        int ordered_qty "Заказано штук (qty — принято; у партии в пути qty = ordered_qty)"
    }
    stock_movements {
        bigint id PK "Движение (по времени)"
        moment at "Момент"
        int warehouse_id FK "Склад или пункт выдачи"
        int cell_id FK "Ячейка; NULL — без адреса (пункт выдачи, зона приёмки)"
        int product_id FK "Товар"
        int batch_id FK "Партия; NULL — не партионный учёт (FBS)"
        text kind "Вид движения"
        int qty "Количество: + приход, − расход"
        text ref_type "К чему относится"
        bigint ref_id "Id документа по ref_type"
    }
    sellers {
        int id PK "Продавец"
        text name "Название магазина продавца"
        int city_id FK "Город"
        text model "Модель: товар на нашем складе (fbo) или отгружает сам (fbs)"
        moment joined_at "Подключился"
        moment left_at "Ушёл; NULL — работает"
        text tax_regime "Налоговый режим: общий (osn, НДС 20/22 %) или упрощённый (usn: без НДС до порога выручки, который снижается по годам; выше — 5 или 7 %)"
    }
    offers {
        int id PK "Предложение"
        int seller_id FK "Продавец"
        int product_id FK "Товар"
        moment valid_from "С (включительно)"
        moment valid_to "По (исключая); NULL — без конца в периоде"
        money price "Цена с НДС, руб."
    }
    customers {
        int id PK "Клиент"
        text first_name "Имя"
        text last_name "Фамилия"
        text gender "Пол"
        smallint birth_year "Год рождения"
        moment registered_at "Регистрация"
        int city_id FK "Город"
        text acquired_via "Откуда пришёл"
        bool is_b2b "Юрлицо или ИП"
        text company_name "Название организации (b2b)"
    }
    addresses {
        int id PK "Адрес"
        int customer_id FK "Клиент"
        int city_id FK "Город"
        double lat "Широта"
        double lon "Долгота"
        text kind "Вид"
        moment created_at "Добавлен"
    }
    orders {
        int id PK "Заказ (по времени создания)"
        int customer_id FK "Клиент"
        int address_id FK "Адрес курьерской или почтовой доставки"
        int pickup_point_id FK "Пункт выдачи"
        int session_id FK "Сессия сайта или приложения; NULL — заказ по телефону или сессия не попала в журнал (посетитель не дал согласия на аналитику)"
        text channel "Канал"
        text delivery_method "Способ получения"
        moment created_at "Создан"
        moment paid_at "Оплачен"
        moment assembled_at "Собран"
        moment shipped_at "Отгружен"
        moment delivered_at "Получен клиентом"
        moment cancelled_at "Отменён"
        moment estimated_at "Обещанная дата получения"
        text status "Текущий статус на «сейчас» выгрузки"
        text promo_code "Введённый промокод"
        money items_amount "Сумма строк до скидок, руб."
        money discount_amount "Скидки, руб."
        money delivery_amount "Доставка, руб."
        money vat_amount "НДС в итоге, руб."
        money total_amount "Итого к оплате, руб."
    }
    order_items {
        int order_id PK, FK "Заказ"
        smallint line_no PK "Номер строки: 1, 2, …"
        int product_id FK "Товар"
        int seller_id FK "Продавец; NULL — товар магазина (1P)"
        int offer_id FK "Предложение продавца"
        smallint qty "Штук"
        money unit_price "Цена за штуку на момент заказа, руб."
        money discount "Скидка на строку, руб."
        smallint vat_rate "Ставка НДС, % (на дату заказа; 0 — продавец без НДС)"
        money vat_amount "НДС строки, руб."
        int warehouse_id FK "Склад отгрузки; NULL — продавец FBS отгружает сам"
        int promo_id FK "Применённая акция"
    }
    order_status_log {
        int order_id PK, FK "Заказ"
        smallint seq PK "Номер перехода: 1, 2, …"
        moment at "Момент"
        text status "Новый статус"
    }
    payments {
        int id PK "Платёж"
        int order_id FK "Заказ"
        smallint seq "Номер платежа в заказе"
        text method "Способ"
        smallint installments "Месяцев рассрочки"
        money amount "Сумма, руб. (возврат — со знаком минус)"
        text status "Статус"
        moment at "Момент"
    }
    shipments {
        int id PK "Отгрузка"
        int order_id FK "Заказ"
        int warehouse_id FK "Склад отгрузки"
        int carrier_id FK "Перевозчик"
        int zone_id FK "Зона доставки; NULL — вне зон (почта по стране)"
        moment planned_at "План отгрузки"
        moment shipped_at "Отгружено"
        moment delivered_at "Доставлено"
        text status "Статус"
        int weight_g "Вес, г"
        smallint boxes "Мест"
    }
    returns {
        int id PK "Возврат"
        int order_id FK "Заказ"
        smallint line_no FK "Строка заказа"
        smallint qty "Штук"
        moment requested_at "Заявлен"
        moment received_at "Товар получен магазином"
        text reason "Причина"
        text condition "Состояние товара"
        text decision "Решение"
        money refund "Возвращено, руб."
    }
    reviews {
        int id PK "Отзыв"
        int order_id FK "Заказ"
        int product_id FK "Товар"
        int customer_id FK "Клиент"
        smallint score "Оценка 1–5"
        moment created_at "Написан"
        moment answered_at "Ответ магазина или продавца"
        text text "Текст"
    }
    sessions {
        int id PK "Сессия (по времени начала)"
        int customer_id FK "Клиент; NULL — не вошёл"
        moment started_at "Начало"
        moment ended_at "Конец"
        text device "Устройство"
        text source "Источник перехода"
        int city_id FK "Город по геолокации"
    }
    session_events {
        int session_id PK, FK "Сессия"
        int seq PK "Номер события в сессии"
        moment at "Момент"
        text kind "Событие"
        int product_id FK "Товар"
        text query "Поисковый запрос"
    }
    categories |o--o{ categories : "parent_id"
    brands ||--o{ products : "brand_id"
    categories ||--o{ products : "category_id"
    products ||--o{ product_specs : "product_id"
    spec_keys ||--o{ product_specs : "key"
    products ||--o{ bundle_items : "bundle_id"
    products ||--o{ bundle_items : "component_id"
    products ||--o{ prices : "product_id"
    promotions ||--o{ promotion_targets : "promo_id"
    products |o--o{ promotion_targets : "product_id"
    categories |o--o{ promotion_targets : "category_id"
    warehouses |o--o{ warehouses : "parent_id"
    cities ||--o{ warehouses : "city_id"
    warehouses ||--o{ storage_cells : "warehouse_id"
    warehouses ||--o{ delivery_zones : "warehouse_id"
    carriers ||--o{ delivery_zones : "carrier_id"
    cities ||--o{ suppliers : "city_id"
    suppliers ||--o{ purchase_orders : "supplier_id"
    warehouses ||--o{ purchase_orders : "warehouse_id"
    purchase_orders |o--o{ batches : "po_id"
    sellers |o--o{ batches : "seller_id"
    products ||--o{ batches : "product_id"
    warehouses ||--o{ batches : "warehouse_id"
    warehouses ||--o{ stock_movements : "warehouse_id"
    storage_cells |o--o{ stock_movements : "cell_id"
    products ||--o{ stock_movements : "product_id"
    batches |o--o{ stock_movements : "batch_id"
    cities ||--o{ sellers : "city_id"
    sellers ||--o{ offers : "seller_id"
    products ||--o{ offers : "product_id"
    cities ||--o{ customers : "city_id"
    customers ||--o{ addresses : "customer_id"
    cities ||--o{ addresses : "city_id"
    customers ||--o{ orders : "customer_id"
    addresses |o--o{ orders : "address_id"
    warehouses |o--o{ orders : "pickup_point_id"
    sessions |o--o{ orders : "session_id"
    orders ||--o{ order_items : "order_id"
    products ||--o{ order_items : "product_id"
    sellers |o--o{ order_items : "seller_id"
    offers |o--o{ order_items : "offer_id"
    warehouses |o--o{ order_items : "warehouse_id"
    promotions |o--o{ order_items : "promo_id"
    orders ||--o{ order_status_log : "order_id"
    orders ||--o{ payments : "order_id"
    orders ||--o{ shipments : "order_id"
    warehouses ||--o{ shipments : "warehouse_id"
    carriers ||--o{ shipments : "carrier_id"
    delivery_zones |o--o{ shipments : "zone_id"
    order_items ||--o{ returns : "order_id, line_no"
    orders ||--o{ reviews : "order_id"
    products ||--o{ reviews : "product_id"
    customers ||--o{ reviews : "customer_id"
    customers |o--o{ sessions : "customer_id"
    cities |o--o{ sessions : "city_id"
    sessions ||--o{ session_events : "session_id"
    products |o--o{ session_events : "product_id"
