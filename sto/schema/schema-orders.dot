// sto-data-v1 — группа «Заказы»: все поля её таблиц; таблицы других групп, на которые они ссылаются, — серой рамкой.
// Сгенерировано из описания схемы; руками не править. Картинка (SVG): tools/schema-svg.sh sto.
digraph schema {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.9, pad=0.3, splines=true, newrank=true];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [dir=both, arrowtail=none, arrowhead=crow, arrowsize=0.9, color="#333333"];
  subgraph "cluster_orders" {
    label=<<B>Заказы</B>>;
    style="rounded,filled"; fillcolor="#ececec"; color="#bbbbbb"; margin=14;
    "orders" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>orders</B><BR/>Заказы</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>customer_id</TD></TR><TR><TD ALIGN="LEFT" PORT="address_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>address_id</TD></TR><TR><TD ALIGN="LEFT" PORT="pickup_point_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>pickup_point_id</TD></TR><TR><TD ALIGN="LEFT" PORT="session_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>session_id</TD></TR><TR><TD ALIGN="LEFT" PORT="channel"><FONT FACE="DejaVu Sans Mono">∗ </FONT>channel</TD></TR><TR><TD ALIGN="LEFT" PORT="delivery_method"><FONT FACE="DejaVu Sans Mono">∗ </FONT>delivery_method</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>created_at</TD></TR><TR><TD ALIGN="LEFT" PORT="paid_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>paid_at</TD></TR><TR><TD ALIGN="LEFT" PORT="assembled_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>assembled_at</TD></TR><TR><TD ALIGN="LEFT" PORT="shipped_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>shipped_at</TD></TR><TR><TD ALIGN="LEFT" PORT="delivered_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>delivered_at</TD></TR><TR><TD ALIGN="LEFT" PORT="cancelled_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>cancelled_at</TD></TR><TR><TD ALIGN="LEFT" PORT="estimated_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>estimated_at</TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT FACE="DejaVu Sans Mono">∗ </FONT>status</TD></TR><TR><TD ALIGN="LEFT" PORT="promo_code"><FONT FACE="DejaVu Sans Mono">○ </FONT>promo_code</TD></TR><TR><TD ALIGN="LEFT" PORT="items_amount"><FONT FACE="DejaVu Sans Mono">∗ </FONT>items_amount</TD></TR><TR><TD ALIGN="LEFT" PORT="discount_amount"><FONT FACE="DejaVu Sans Mono">∗ </FONT>discount_amount</TD></TR><TR><TD ALIGN="LEFT" PORT="delivery_amount"><FONT FACE="DejaVu Sans Mono">∗ </FONT>delivery_amount</TD></TR><TR><TD ALIGN="LEFT" PORT="vat_amount"><FONT FACE="DejaVu Sans Mono">∗ </FONT>vat_amount</TD></TR><TR><TD ALIGN="LEFT" PORT="total_amount"><FONT FACE="DejaVu Sans Mono">∗ </FONT>total_amount</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "order_items" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>order_items</B><BR/>Строки заказов</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="order_id"><FONT FACE="DejaVu Sans Mono"># </FONT>order_id</TD></TR><TR><TD ALIGN="LEFT" PORT="line_no"><FONT FACE="DejaVu Sans Mono"># </FONT>line_no</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>product_id</TD></TR><TR><TD ALIGN="LEFT" PORT="seller_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>seller_id</TD></TR><TR><TD ALIGN="LEFT" PORT="offer_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>offer_id</TD></TR><TR><TD ALIGN="LEFT" PORT="qty"><FONT FACE="DejaVu Sans Mono">∗ </FONT>qty</TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price"><FONT FACE="DejaVu Sans Mono">∗ </FONT>unit_price</TD></TR><TR><TD ALIGN="LEFT" PORT="discount"><FONT FACE="DejaVu Sans Mono">∗ </FONT>discount</TD></TR><TR><TD ALIGN="LEFT" PORT="vat_rate"><FONT FACE="DejaVu Sans Mono">∗ </FONT>vat_rate</TD></TR><TR><TD ALIGN="LEFT" PORT="vat_amount"><FONT FACE="DejaVu Sans Mono">∗ </FONT>vat_amount</TD></TR><TR><TD ALIGN="LEFT" PORT="warehouse_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>warehouse_id</TD></TR><TR><TD ALIGN="LEFT" PORT="promo_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>promo_id</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "order_status_log" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>order_status_log</B><BR/>Статусы заказов</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="order_id"><FONT FACE="DejaVu Sans Mono"># </FONT>order_id</TD></TR><TR><TD ALIGN="LEFT" PORT="seq"><FONT FACE="DejaVu Sans Mono"># </FONT>seq</TD></TR><TR><TD ALIGN="LEFT" PORT="at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>at</TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT FACE="DejaVu Sans Mono">∗ </FONT>status</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "payments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>payments</B><BR/>Платежи</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="order_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>order_id</TD></TR><TR><TD ALIGN="LEFT" PORT="seq"><FONT FACE="DejaVu Sans Mono">∗ </FONT>seq</TD></TR><TR><TD ALIGN="LEFT" PORT="method"><FONT FACE="DejaVu Sans Mono">∗ </FONT>method</TD></TR><TR><TD ALIGN="LEFT" PORT="installments"><FONT FACE="DejaVu Sans Mono">○ </FONT>installments</TD></TR><TR><TD ALIGN="LEFT" PORT="amount"><FONT FACE="DejaVu Sans Mono">∗ </FONT>amount</TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT FACE="DejaVu Sans Mono">∗ </FONT>status</TD></TR><TR><TD ALIGN="LEFT" PORT="at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>at</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "shipments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>shipments</B><BR/>Отгрузки</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="order_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>order_id</TD></TR><TR><TD ALIGN="LEFT" PORT="warehouse_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>warehouse_id</TD></TR><TR><TD ALIGN="LEFT" PORT="carrier_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>carrier_id</TD></TR><TR><TD ALIGN="LEFT" PORT="zone_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>zone_id</TD></TR><TR><TD ALIGN="LEFT" PORT="planned_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>planned_at</TD></TR><TR><TD ALIGN="LEFT" PORT="shipped_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>shipped_at</TD></TR><TR><TD ALIGN="LEFT" PORT="delivered_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>delivered_at</TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT FACE="DejaVu Sans Mono">∗ </FONT>status</TD></TR><TR><TD ALIGN="LEFT" PORT="weight_g"><FONT FACE="DejaVu Sans Mono">∗ </FONT>weight_g</TD></TR><TR><TD ALIGN="LEFT" PORT="boxes"><FONT FACE="DejaVu Sans Mono">∗ </FONT>boxes</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "returns" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>returns</B><BR/>Возвраты</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="order_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>order_id</TD></TR><TR><TD ALIGN="LEFT" PORT="line_no"><FONT FACE="DejaVu Sans Mono">∗ </FONT>line_no</TD></TR><TR><TD ALIGN="LEFT" PORT="qty"><FONT FACE="DejaVu Sans Mono">∗ </FONT>qty</TD></TR><TR><TD ALIGN="LEFT" PORT="requested_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>requested_at</TD></TR><TR><TD ALIGN="LEFT" PORT="received_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>received_at</TD></TR><TR><TD ALIGN="LEFT" PORT="reason"><FONT FACE="DejaVu Sans Mono">∗ </FONT>reason</TD></TR><TR><TD ALIGN="LEFT" PORT="condition"><FONT FACE="DejaVu Sans Mono">○ </FONT>condition</TD></TR><TR><TD ALIGN="LEFT" PORT="decision"><FONT FACE="DejaVu Sans Mono">○ </FONT>decision</TD></TR><TR><TD ALIGN="LEFT" PORT="refund"><FONT FACE="DejaVu Sans Mono">○ </FONT>refund</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "reviews" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>reviews</B><BR/>Отзывы</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="order_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>order_id</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>product_id</TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>customer_id</TD></TR><TR><TD ALIGN="LEFT" PORT="score"><FONT FACE="DejaVu Sans Mono">∗ </FONT>score</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>created_at</TD></TR><TR><TD ALIGN="LEFT" PORT="answered_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>answered_at</TD></TR><TR><TD ALIGN="LEFT" PORT="text"><FONT FACE="DejaVu Sans Mono">○ </FONT>text</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
  }
  "products" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">products<BR/>Товары</FONT></TD></TR></TABLE>>];
  "promotions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">promotions<BR/>Акции</FONT></TD></TR></TABLE>>];
  "warehouses" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">warehouses<BR/>Склады и пункты выдачи</FONT></TD></TR></TABLE>>];
  "carriers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">carriers<BR/>Перевозчики</FONT></TD></TR></TABLE>>];
  "delivery_zones" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">delivery_zones<BR/>Зоны доставки</FONT></TD></TR></TABLE>>];
  "sellers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">sellers<BR/>Продавцы</FONT></TD></TR></TABLE>>];
  "offers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">offers<BR/>Предложения продавцов</FONT></TD></TR></TABLE>>];
  "customers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">customers<BR/>Клиенты</FONT></TD></TR></TABLE>>];
  "addresses" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">addresses<BR/>Адреса</FONT></TD></TR></TABLE>>];
  "sessions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">sessions<BR/>Сессии</FONT></TD></TR></TABLE>>];
  "customers" -> "orders":"customer_id";
  "addresses" -> "orders":"address_id" [style=dashed];
  "warehouses" -> "orders":"pickup_point_id" [style=dashed];
  "sessions" -> "orders":"session_id" [style=dashed];
  "promotions" -> "orders":"promo_code" [style=dashed];
  "orders":"id" -> "order_items":"order_id";
  "products" -> "order_items":"product_id";
  "sellers" -> "order_items":"seller_id" [style=dashed];
  "offers" -> "order_items":"offer_id" [style=dashed];
  "warehouses" -> "order_items":"warehouse_id" [style=dashed];
  "promotions" -> "order_items":"promo_id" [style=dashed];
  "orders":"id" -> "order_status_log":"order_id";
  "orders":"id" -> "payments":"order_id";
  "orders":"id" -> "shipments":"order_id";
  "warehouses" -> "shipments":"warehouse_id";
  "carriers" -> "shipments":"carrier_id";
  "delivery_zones" -> "shipments":"zone_id" [style=dashed];
  "order_items":"order_id" -> "returns":"order_id";
  "orders":"id" -> "reviews":"order_id";
  "products" -> "reviews":"product_id";
  "customers" -> "reviews":"customer_id";
}
