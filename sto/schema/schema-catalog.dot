// sto-data-v1 — группа «Каталог»: все поля её таблиц; таблицы других групп, на которые они ссылаются, — серой рамкой.
// Сгенерировано из описания схемы; руками не править. Картинка (SVG): tools/schema-svg.sh sto.
digraph schema {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.9, pad=0.3, splines=true, newrank=true];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [dir=both, arrowtail=none, arrowhead=crow, arrowsize=0.9, color="#333333"];
  subgraph "cluster_catalog" {
    label=<<B>Каталог</B>>;
    style="rounded,filled"; fillcolor="#ececec"; color="#bbbbbb"; margin=14;
    "categories" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>categories</B><BR/>Категории</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="parent_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>parent_id</TD></TR><TR><TD ALIGN="LEFT" PORT="level"><FONT FACE="DejaVu Sans Mono">∗ </FONT>level</TD></TR><TR><TD ALIGN="LEFT" PORT="name_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="name_en"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_en</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "spec_keys" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>spec_keys</B><BR/>Характеристики</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="key"><FONT FACE="DejaVu Sans Mono"># </FONT>key</TD></TR><TR><TD ALIGN="LEFT" PORT="name_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="name_en"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_en</TD></TR><TR><TD ALIGN="LEFT" PORT="unit"><FONT FACE="DejaVu Sans Mono">○ </FONT>unit</TD></TR><TR><TD ALIGN="LEFT" PORT="value_type"><FONT FACE="DejaVu Sans Mono">∗ </FONT>value_type</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "brands" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>brands</B><BR/>Бренды</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name</TD></TR><TR><TD ALIGN="LEFT" PORT="origin_country"><FONT FACE="DejaVu Sans Mono">∗ </FONT>origin_country</TD></TR><TR><TD ALIGN="LEFT" PORT="tier"><FONT FACE="DejaVu Sans Mono">∗ </FONT>tier</TD></TR><TR><TD ALIGN="LEFT" PORT="is_private_label"><FONT FACE="DejaVu Sans Mono">∗ </FONT>is_private_label</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "products" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>products</B><BR/>Товары</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="sku"><FONT FACE="DejaVu Sans Mono">∗ </FONT>sku</TD></TR><TR><TD ALIGN="LEFT" PORT="ean13"><FONT FACE="DejaVu Sans Mono">∗ </FONT>ean13</TD></TR><TR><TD ALIGN="LEFT" PORT="brand_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>brand_id</TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>category_id</TD></TR><TR><TD ALIGN="LEFT" PORT="name_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="name_en"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_en</TD></TR><TR><TD ALIGN="LEFT" PORT="model_line"><FONT FACE="DejaVu Sans Mono">∗ </FONT>model_line</TD></TR><TR><TD ALIGN="LEFT" PORT="generation"><FONT FACE="DejaVu Sans Mono">∗ </FONT>generation</TD></TR><TR><TD ALIGN="LEFT" PORT="launched_on"><FONT FACE="DejaVu Sans Mono">∗ </FONT>launched_on</TD></TR><TR><TD ALIGN="LEFT" PORT="discontinued_on"><FONT FACE="DejaVu Sans Mono">○ </FONT>discontinued_on</TD></TR><TR><TD ALIGN="LEFT" PORT="weight_g"><FONT FACE="DejaVu Sans Mono">∗ </FONT>weight_g</TD></TR><TR><TD ALIGN="LEFT" PORT="length_mm"><FONT FACE="DejaVu Sans Mono">∗ </FONT>length_mm</TD></TR><TR><TD ALIGN="LEFT" PORT="width_mm"><FONT FACE="DejaVu Sans Mono">∗ </FONT>width_mm</TD></TR><TR><TD ALIGN="LEFT" PORT="height_mm"><FONT FACE="DejaVu Sans Mono">∗ </FONT>height_mm</TD></TR><TR><TD ALIGN="LEFT" PORT="warranty_months"><FONT FACE="DejaVu Sans Mono">∗ </FONT>warranty_months</TD></TR><TR><TD ALIGN="LEFT" PORT="is_bundle"><FONT FACE="DejaVu Sans Mono">∗ </FONT>is_bundle</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "product_specs" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>product_specs</B><BR/>Значения характеристик</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><FONT FACE="DejaVu Sans Mono"># </FONT>product_id</TD></TR><TR><TD ALIGN="LEFT" PORT="key"><FONT FACE="DejaVu Sans Mono"># </FONT>key</TD></TR><TR><TD ALIGN="LEFT" PORT="value_text"><FONT FACE="DejaVu Sans Mono">○ </FONT>value_text</TD></TR><TR><TD ALIGN="LEFT" PORT="value_num"><FONT FACE="DejaVu Sans Mono">○ </FONT>value_num</TD></TR><TR><TD ALIGN="LEFT" PORT="unit"><FONT FACE="DejaVu Sans Mono">○ </FONT>unit</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "bundle_items" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>bundle_items</B><BR/>Состав комплектов</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="bundle_id"><FONT FACE="DejaVu Sans Mono"># </FONT>bundle_id</TD></TR><TR><TD ALIGN="LEFT" PORT="component_id"><FONT FACE="DejaVu Sans Mono"># </FONT>component_id</TD></TR><TR><TD ALIGN="LEFT" PORT="qty"><FONT FACE="DejaVu Sans Mono">∗ </FONT>qty</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "prices" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>prices</B><BR/>Цены</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><FONT FACE="DejaVu Sans Mono"># </FONT>product_id</TD></TR><TR><TD ALIGN="LEFT" PORT="valid_from"><FONT FACE="DejaVu Sans Mono"># </FONT>valid_from</TD></TR><TR><TD ALIGN="LEFT" PORT="valid_to"><FONT FACE="DejaVu Sans Mono">○ </FONT>valid_to</TD></TR><TR><TD ALIGN="LEFT" PORT="price"><FONT FACE="DejaVu Sans Mono">∗ </FONT>price</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "promotions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>promotions</B><BR/>Акции</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD ALIGN="LEFT" PORT="name_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="name_en"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_en</TD></TR><TR><TD ALIGN="LEFT" PORT="event"><FONT FACE="DejaVu Sans Mono">○ </FONT>event</TD></TR><TR><TD ALIGN="LEFT" PORT="discount_pct"><FONT FACE="DejaVu Sans Mono">○ </FONT>discount_pct</TD></TR><TR><TD ALIGN="LEFT" PORT="discount_amount"><FONT FACE="DejaVu Sans Mono">○ </FONT>discount_amount</TD></TR><TR><TD ALIGN="LEFT" PORT="buy_qty"><FONT FACE="DejaVu Sans Mono">○ </FONT>buy_qty</TD></TR><TR><TD ALIGN="LEFT" PORT="free_qty"><FONT FACE="DejaVu Sans Mono">○ </FONT>free_qty</TD></TR><TR><TD ALIGN="LEFT" PORT="promo_code"><FONT FACE="DejaVu Sans Mono">○ </FONT>promo_code</TD></TR><TR><TD ALIGN="LEFT" PORT="min_order_amount"><FONT FACE="DejaVu Sans Mono">○ </FONT>min_order_amount</TD></TR><TR><TD ALIGN="LEFT" PORT="valid_from"><FONT FACE="DejaVu Sans Mono">∗ </FONT>valid_from</TD></TR><TR><TD ALIGN="LEFT" PORT="valid_to"><FONT FACE="DejaVu Sans Mono">∗ </FONT>valid_to</TD></TR><TR><TD ALIGN="LEFT" PORT="stackable"><FONT FACE="DejaVu Sans Mono">∗ </FONT>stackable</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "promotion_targets" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>promotion_targets</B><BR/>Цели акций</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="promo_id"><FONT FACE="DejaVu Sans Mono"># </FONT>promo_id</TD></TR><TR><TD ALIGN="LEFT" PORT="seq"><FONT FACE="DejaVu Sans Mono"># </FONT>seq</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>product_id</TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>category_id</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
  }
  "categories":"id":e -> "categories":"parent_id":e [style=dashed];
  "brands":"id" -> "products":"brand_id";
  "categories":"id" -> "products":"category_id";
  "products":"id" -> "product_specs":"product_id";
  "spec_keys":"key" -> "product_specs":"key";
  "products":"id" -> "bundle_items":"bundle_id";
  "products":"id" -> "bundle_items":"component_id";
  "products":"id" -> "prices":"product_id";
  "promotions":"id" -> "promotion_targets":"promo_id";
  "products":"id" -> "promotion_targets":"product_id" [style=dashed];
  "categories":"id" -> "promotion_targets":"category_id" [style=dashed];
}
