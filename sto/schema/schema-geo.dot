// sto-data-v1 — группа «География и склады»: все поля её таблиц; таблицы других групп, на которые они ссылаются, — серой рамкой.
// Сгенерировано из описания схемы; руками не править. Картинка (SVG): tools/schema-svg.sh sto.
digraph schema {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.9, pad=0.3, splines=true, newrank=true];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [dir=both, arrowtail=none, arrowhead=crow, arrowsize=0.9, color="#333333"];
  subgraph "cluster_geo" {
    label=<<B>География и склады</B>>;
    style="rounded,filled"; fillcolor="#ececec"; color="#bbbbbb"; margin=14;
    "cities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>cities</B><BR/>Города</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="name_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="name_en"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_en</TD></TR><TR><TD ALIGN="LEFT" PORT="region_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>region_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="region_en"><FONT FACE="DejaVu Sans Mono">∗ </FONT>region_en</TD></TR><TR><TD ALIGN="LEFT" PORT="federal_district"><FONT FACE="DejaVu Sans Mono">∗ </FONT>federal_district</TD></TR><TR><TD ALIGN="LEFT" PORT="lat"><FONT FACE="DejaVu Sans Mono">∗ </FONT>lat</TD></TR><TR><TD ALIGN="LEFT" PORT="lon"><FONT FACE="DejaVu Sans Mono">∗ </FONT>lon</TD></TR><TR><TD ALIGN="LEFT" PORT="timezone"><FONT FACE="DejaVu Sans Mono">∗ </FONT>timezone</TD></TR><TR><TD ALIGN="LEFT" PORT="population"><FONT FACE="DejaVu Sans Mono">∗ </FONT>population</TD></TR><TR><TD ALIGN="LEFT" PORT="airport_code"><FONT FACE="DejaVu Sans Mono">∗ </FONT>airport_code</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "warehouses" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>warehouses</B><BR/>Склады и пункты выдачи</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="parent_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>parent_id</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD ALIGN="LEFT" PORT="code"><FONT FACE="DejaVu Sans Mono">∗ </FONT>code</TD></TR><TR><TD ALIGN="LEFT" PORT="name_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="name_en"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_en</TD></TR><TR><TD ALIGN="LEFT" PORT="city_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>city_id</TD></TR><TR><TD ALIGN="LEFT" PORT="lat"><FONT FACE="DejaVu Sans Mono">∗ </FONT>lat</TD></TR><TR><TD ALIGN="LEFT" PORT="lon"><FONT FACE="DejaVu Sans Mono">∗ </FONT>lon</TD></TR><TR><TD ALIGN="LEFT" PORT="opened_on"><FONT FACE="DejaVu Sans Mono">∗ </FONT>opened_on</TD></TR><TR><TD ALIGN="LEFT" PORT="closed_on"><FONT FACE="DejaVu Sans Mono">○ </FONT>closed_on</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "storage_cells" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>storage_cells</B><BR/>Ячейки хранения</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="warehouse_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>warehouse_id</TD></TR><TR><TD ALIGN="LEFT" PORT="zone"><FONT FACE="DejaVu Sans Mono">∗ </FONT>zone</TD></TR><TR><TD ALIGN="LEFT" PORT="code"><FONT FACE="DejaVu Sans Mono">∗ </FONT>code</TD></TR><TR><TD ALIGN="LEFT" PORT="rack"><FONT FACE="DejaVu Sans Mono">∗ </FONT>rack</TD></TR><TR><TD ALIGN="LEFT" PORT="shelf"><FONT FACE="DejaVu Sans Mono">∗ </FONT>shelf</TD></TR><TR><TD ALIGN="LEFT" PORT="cell"><FONT FACE="DejaVu Sans Mono">∗ </FONT>cell</TD></TR><TR><TD ALIGN="LEFT" PORT="max_weight_kg"><FONT FACE="DejaVu Sans Mono">∗ </FONT>max_weight_kg</TD></TR><TR><TD ALIGN="LEFT" PORT="max_volume_l"><FONT FACE="DejaVu Sans Mono">∗ </FONT>max_volume_l</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "carriers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>carriers</B><BR/>Перевозчики</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="name_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="name_en"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_en</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "delivery_zones" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>delivery_zones</B><BR/>Зоны доставки</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="warehouse_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>warehouse_id</TD></TR><TR><TD ALIGN="LEFT" PORT="carrier_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>carrier_id</TD></TR><TR><TD ALIGN="LEFT" PORT="ring"><FONT FACE="DejaVu Sans Mono">∗ </FONT>ring</TD></TR><TR><TD ALIGN="LEFT" PORT="polygon"><FONT FACE="DejaVu Sans Mono">∗ </FONT>polygon</TD></TR><TR><TD ALIGN="LEFT" PORT="base_days"><FONT FACE="DejaVu Sans Mono">∗ </FONT>base_days</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
  }
  "warehouses":"id":e -> "warehouses":"parent_id":e [style=dashed];
  "cities":"id" -> "warehouses":"city_id";
  "warehouses":"id" -> "storage_cells":"warehouse_id";
  "warehouses":"id" -> "delivery_zones":"warehouse_id";
  "carriers":"id" -> "delivery_zones":"carrier_id";
}
