// sto-data-v1 — группа «Маркетплейс»: все поля её таблиц; таблицы других групп, на которые они ссылаются, — серой рамкой.
// Сгенерировано из описания схемы; руками не править. Картинка (SVG): tools/schema-svg.sh sto.
digraph schema {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.9, pad=0.3, splines=true, newrank=true];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [dir=both, arrowtail=none, arrowhead=crow, arrowsize=0.9, color="#333333"];
  subgraph "cluster_market" {
    label=<<B>Маркетплейс</B>>;
    style="rounded,filled"; fillcolor="#ececec"; color="#bbbbbb"; margin=14;
    "sellers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>sellers</B><BR/>Продавцы</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name</TD></TR><TR><TD ALIGN="LEFT" PORT="city_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>city_id</TD></TR><TR><TD ALIGN="LEFT" PORT="model"><FONT FACE="DejaVu Sans Mono">∗ </FONT>model</TD></TR><TR><TD ALIGN="LEFT" PORT="joined_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>joined_at</TD></TR><TR><TD ALIGN="LEFT" PORT="left_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>left_at</TD></TR><TR><TD ALIGN="LEFT" PORT="tax_regime"><FONT FACE="DejaVu Sans Mono">∗ </FONT>tax_regime</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "offers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>offers</B><BR/>Предложения продавцов</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="seller_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>seller_id</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>product_id</TD></TR><TR><TD ALIGN="LEFT" PORT="valid_from"><FONT FACE="DejaVu Sans Mono">∗ </FONT>valid_from</TD></TR><TR><TD ALIGN="LEFT" PORT="valid_to"><FONT FACE="DejaVu Sans Mono">○ </FONT>valid_to</TD></TR><TR><TD ALIGN="LEFT" PORT="price"><FONT FACE="DejaVu Sans Mono">∗ </FONT>price</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
  }
  "products" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">products<BR/>Товары</FONT></TD></TR></TABLE>>];
  "cities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">cities<BR/>Города</FONT></TD></TR></TABLE>>];
  "cities" -> "sellers":"city_id";
  "sellers":"id" -> "offers":"seller_id";
  "products" -> "offers":"product_id";
}
