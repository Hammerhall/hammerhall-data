// sto-data-v1 — группа «Поставки и складские движения»: все поля её таблиц; таблицы других групп, на которые они ссылаются, — серой рамкой.
// Сгенерировано из описания схемы; руками не править. Картинка (SVG): tools/schema-svg.sh sto.
digraph schema {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.9, pad=0.3, splines=true, newrank=true];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [dir=both, arrowtail=none, arrowhead=crow, arrowsize=0.9, color="#333333"];
  subgraph "cluster_supply" {
    label=<<B>Поставки и складские движения</B>>;
    style="rounded,filled"; fillcolor="#ececec"; color="#bbbbbb"; margin=14;
    "suppliers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>suppliers</B><BR/>Поставщики</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="name_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="name_en"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_en</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD ALIGN="LEFT" PORT="city_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>city_id</TD></TR><TR><TD ALIGN="LEFT" PORT="lead_time_days"><FONT FACE="DejaVu Sans Mono">∗ </FONT>lead_time_days</TD></TR><TR><TD ALIGN="LEFT" PORT="reliability"><FONT FACE="DejaVu Sans Mono">∗ </FONT>reliability</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "purchase_orders" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>purchase_orders</B><BR/>Заказы поставщикам</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="supplier_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>supplier_id</TD></TR><TR><TD ALIGN="LEFT" PORT="warehouse_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>warehouse_id</TD></TR><TR><TD ALIGN="LEFT" PORT="ordered_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>ordered_at</TD></TR><TR><TD ALIGN="LEFT" PORT="expected_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>expected_at</TD></TR><TR><TD ALIGN="LEFT" PORT="received_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>received_at</TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT FACE="DejaVu Sans Mono">∗ </FONT>status</TD></TR><TR><TD ALIGN="LEFT" PORT="purpose"><FONT FACE="DejaVu Sans Mono">∗ </FONT>purpose</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "batches" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>batches</B><BR/>Партии</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="po_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>po_id</TD></TR><TR><TD ALIGN="LEFT" PORT="seller_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>seller_id</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>product_id</TD></TR><TR><TD ALIGN="LEFT" PORT="warehouse_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>warehouse_id</TD></TR><TR><TD ALIGN="LEFT" PORT="qty"><FONT FACE="DejaVu Sans Mono">∗ </FONT>qty</TD></TR><TR><TD ALIGN="LEFT" PORT="unit_cost"><FONT FACE="DejaVu Sans Mono">∗ </FONT>unit_cost</TD></TR><TR><TD ALIGN="LEFT" PORT="received_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>received_at</TD></TR><TR><TD ALIGN="LEFT" PORT="ordered_qty"><FONT FACE="DejaVu Sans Mono">∗ </FONT>ordered_qty</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "stock_movements" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>stock_movements</B><BR/>Складские движения</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>at</TD></TR><TR><TD ALIGN="LEFT" PORT="warehouse_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>warehouse_id</TD></TR><TR><TD ALIGN="LEFT" PORT="cell_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>cell_id</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>product_id</TD></TR><TR><TD ALIGN="LEFT" PORT="batch_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>batch_id</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD ALIGN="LEFT" PORT="qty"><FONT FACE="DejaVu Sans Mono">∗ </FONT>qty</TD></TR><TR><TD ALIGN="LEFT" PORT="ref_type"><FONT FACE="DejaVu Sans Mono">○ </FONT>ref_type</TD></TR><TR><TD ALIGN="LEFT" PORT="ref_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>ref_id</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
  }
  "products" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">products<BR/>Товары</FONT></TD></TR></TABLE>>];
  "cities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">cities<BR/>Города</FONT></TD></TR></TABLE>>];
  "warehouses" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">warehouses<BR/>Склады и пункты выдачи</FONT></TD></TR></TABLE>>];
  "storage_cells" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">storage_cells<BR/>Ячейки хранения</FONT></TD></TR></TABLE>>];
  "sellers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">sellers<BR/>Продавцы</FONT></TD></TR></TABLE>>];
  "cities" -> "suppliers":"city_id";
  "suppliers":"id" -> "purchase_orders":"supplier_id";
  "warehouses" -> "purchase_orders":"warehouse_id";
  "purchase_orders":"id" -> "batches":"po_id" [style=dashed];
  "sellers" -> "batches":"seller_id" [style=dashed];
  "products" -> "batches":"product_id";
  "warehouses" -> "batches":"warehouse_id";
  "warehouses" -> "stock_movements":"warehouse_id";
  "storage_cells" -> "stock_movements":"cell_id" [style=dashed];
  "products" -> "stock_movements":"product_id";
  "batches":"id" -> "stock_movements":"batch_id" [style=dashed];
}
