// auc-data-v1 — группа «Сайт и уведомления»: все поля её таблиц; таблицы других групп, на которые они ссылаются, — серой рамкой.
// Сгенерировано из описания схемы; руками не править. Картинка (SVG): tools/schema-svg.sh auc.
digraph schema {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.9, pad=0.3, splines=true, newrank=true];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [dir=both, arrowtail=none, arrowhead=crow, arrowsize=0.9, color="#333333"];
  subgraph "cluster_site" {
    label=<<B>Сайт и уведомления</B>>;
    style="rounded,filled"; fillcolor="#ececec"; color="#bbbbbb"; margin=14;
    "watchlist" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>watchlist</B><BR/>Наблюдения за лотами</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="client_id"><FONT FACE="DejaVu Sans Mono"># </FONT>client_id</TD></TR><TR><TD ALIGN="LEFT" PORT="lot_id"><FONT FACE="DejaVu Sans Mono"># </FONT>lot_id</TD></TR><TR><TD ALIGN="LEFT" PORT="added_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>added_at</TD></TR><TR><TD ALIGN="LEFT" PORT="removed_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>removed_at</TD></TR><TR><TD ALIGN="LEFT" PORT="via"><FONT FACE="DejaVu Sans Mono">∗ </FONT>via</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "sessions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>sessions</B><BR/>Визиты</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="client_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>client_id</TD></TR><TR><TD ALIGN="LEFT" PORT="device_key"><FONT FACE="DejaVu Sans Mono">∗ </FONT>device_key</TD></TR><TR><TD ALIGN="LEFT" PORT="device"><FONT FACE="DejaVu Sans Mono">∗ </FONT>device</TD></TR><TR><TD ALIGN="LEFT" PORT="source"><FONT FACE="DejaVu Sans Mono">∗ </FONT>source</TD></TR><TR><TD ALIGN="LEFT" PORT="city_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>city_id</TD></TR><TR><TD ALIGN="LEFT" PORT="started_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>started_at</TD></TR><TR><TD ALIGN="LEFT" PORT="ended_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>ended_at</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "session_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>session_events</B><BR/>События визитов</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="session_id"><FONT FACE="DejaVu Sans Mono"># </FONT>session_id</TD></TR><TR><TD ALIGN="LEFT" PORT="seq"><FONT FACE="DejaVu Sans Mono"># </FONT>seq</TD></TR><TR><TD ALIGN="LEFT" PORT="at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>at</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>sale_id</TD></TR><TR><TD ALIGN="LEFT" PORT="lot_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>lot_id</TD></TR><TR><TD ALIGN="LEFT" PORT="query"><FONT FACE="DejaVu Sans Mono">○ </FONT>query</TD></TR><TR><TD ALIGN="LEFT" PORT="results"><FONT FACE="DejaVu Sans Mono">○ </FONT>results</TD></TR><TR><TD ALIGN="LEFT" PORT="page"><FONT FACE="DejaVu Sans Mono">○ </FONT>page</TD></TR><TR><TD ALIGN="LEFT" PORT="bid_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>bid_id</TD></TR><TR><TD ALIGN="LEFT" PORT="bid_order_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>bid_order_id</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "notifications" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>notifications</B><BR/>Уведомления</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="client_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>client_id</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD ALIGN="LEFT" PORT="channel"><FONT FACE="DejaVu Sans Mono">∗ </FONT>channel</TD></TR><TR><TD ALIGN="LEFT" PORT="event_key"><FONT FACE="DejaVu Sans Mono">∗ </FONT>event_key</TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>sale_id</TD></TR><TR><TD ALIGN="LEFT" PORT="lot_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>lot_id</TD></TR><TR><TD ALIGN="LEFT" PORT="invoice_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>invoice_id</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>created_at</TD></TR><TR><TD ALIGN="LEFT" PORT="sent_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>sent_at</TD></TR><TR><TD ALIGN="LEFT" PORT="delivered_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>delivered_at</TD></TR><TR><TD ALIGN="LEFT" PORT="attempts"><FONT FACE="DejaVu Sans Mono">∗ </FONT>attempts</TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT FACE="DejaVu Sans Mono">∗ </FONT>status</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
  }
  "cities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">cities<BR/>Города</FONT></TD></TR></TABLE>>];
  "clients" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">clients<BR/>Клиенты</FONT></TD></TR></TABLE>>];
  "sales" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">sales<BR/>Торги</FONT></TD></TR></TABLE>>];
  "lots" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">lots<BR/>Лоты</FONT></TD></TR></TABLE>>];
  "bid_orders" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">bid_orders<BR/>Поручения</FONT></TD></TR></TABLE>>];
  "bids" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">bids<BR/>Ставки</FONT></TD></TR></TABLE>>];
  "invoices" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">invoices<BR/>Счета</FONT></TD></TR></TABLE>>];
  "clients" -> "watchlist":"client_id";
  "lots" -> "watchlist":"lot_id";
  "clients" -> "sessions":"client_id" [style=dashed];
  "cities" -> "sessions":"city_id" [style=dashed];
  "sessions":"id" -> "session_events":"session_id";
  "sales" -> "session_events":"sale_id" [style=dashed];
  "lots" -> "session_events":"lot_id" [style=dashed];
  "bids" -> "session_events":"bid_id" [style=dashed];
  "bid_orders" -> "session_events":"bid_order_id" [style=dashed];
  "clients" -> "notifications":"client_id";
  "sales" -> "notifications":"sale_id" [style=dashed];
  "lots" -> "notifications":"lot_id" [style=dashed];
  "invoices" -> "notifications":"invoice_id" [style=dashed];
}
