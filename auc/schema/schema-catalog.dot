// auc-data-v1 — группа «Мастера и вещи»: все поля её таблиц; таблицы других групп, на которые они ссылаются, — серой рамкой.
// Сгенерировано из описания схемы; руками не править. Картинка (SVG): tools/schema-svg.sh auc.
digraph schema {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.9, pad=0.3, splines=true, newrank=true];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [dir=both, arrowtail=none, arrowhead=crow, arrowsize=0.9, color="#333333"];
  subgraph "cluster_catalog" {
    label=<<B>Мастера и вещи</B>>;
    style="rounded,filled"; fillcolor="#ececec"; color="#bbbbbb"; margin=14;
    "makers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>makers</B><BR/>Мастера</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD ALIGN="LEFT" PORT="department_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>department_id</TD></TR><TR><TD ALIGN="LEFT" PORT="is_person"><FONT FACE="DejaVu Sans Mono">∗ </FONT>is_person</TD></TR><TR><TD ALIGN="LEFT" PORT="name_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="name_en"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_en</TD></TR><TR><TD ALIGN="LEFT" PORT="first_name"><FONT FACE="DejaVu Sans Mono">○ </FONT>first_name</TD></TR><TR><TD ALIGN="LEFT" PORT="patronymic"><FONT FACE="DejaVu Sans Mono">○ </FONT>patronymic</TD></TR><TR><TD ALIGN="LEFT" PORT="last_name"><FONT FACE="DejaVu Sans Mono">○ </FONT>last_name</TD></TR><TR><TD ALIGN="LEFT" PORT="active_from"><FONT FACE="DejaVu Sans Mono">∗ </FONT>active_from</TD></TR><TR><TD ALIGN="LEFT" PORT="active_to"><FONT FACE="DejaVu Sans Mono">○ </FONT>active_to</TD></TR><TR><TD ALIGN="LEFT" PORT="country"><FONT FACE="DejaVu Sans Mono">∗ </FONT>country</TD></TR><TR><TD ALIGN="LEFT" PORT="city_ru"><FONT FACE="DejaVu Sans Mono">○ </FONT>city_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="school_ru"><FONT FACE="DejaVu Sans Mono">○ </FONT>school_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="specialty_ru"><FONT FACE="DejaVu Sans Mono">○ </FONT>specialty_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="mark_ru"><FONT FACE="DejaVu Sans Mono">○ </FONT>mark_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="tier"><FONT FACE="DejaVu Sans Mono">∗ </FONT>tier</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "items" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>items</B><BR/>Вещи</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="consignor_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>consignor_id</TD></TR><TR><TD ALIGN="LEFT" PORT="office_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>office_id</TD></TR><TR><TD ALIGN="LEFT" PORT="specialist_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>specialist_id</TD></TR><TR><TD ALIGN="LEFT" PORT="received_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>received_at</TD></TR><TR><TD ALIGN="LEFT" PORT="decided_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>decided_at</TD></TR><TR><TD ALIGN="LEFT" PORT="accepted"><FONT FACE="DejaVu Sans Mono">∗ </FONT>accepted</TD></TR><TR><TD ALIGN="LEFT" PORT="decline_reason"><FONT FACE="DejaVu Sans Mono">○ </FONT>decline_reason</TD></TR><TR><TD ALIGN="LEFT" PORT="department_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>department_id</TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>category_id</TD></TR><TR><TD ALIGN="LEFT" PORT="maker_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>maker_id</TD></TR><TR><TD ALIGN="LEFT" PORT="attribution"><FONT FACE="DejaVu Sans Mono">∗ </FONT>attribution</TD></TR><TR><TD ALIGN="LEFT" PORT="title_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>title_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="title_en"><FONT FACE="DejaVu Sans Mono">∗ </FONT>title_en</TD></TR><TR><TD ALIGN="LEFT" PORT="description_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>description_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="condition_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>condition_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="condition_grade"><FONT FACE="DejaVu Sans Mono">∗ </FONT>condition_grade</TD></TR><TR><TD ALIGN="LEFT" PORT="dating_ru"><FONT FACE="DejaVu Sans Mono">○ </FONT>dating_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="year_from"><FONT FACE="DejaVu Sans Mono">○ </FONT>year_from</TD></TR><TR><TD ALIGN="LEFT" PORT="year_to"><FONT FACE="DejaVu Sans Mono">○ </FONT>year_to</TD></TR><TR><TD ALIGN="LEFT" PORT="origin_place_ru"><FONT FACE="DejaVu Sans Mono">○ </FONT>origin_place_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="material_ru"><FONT FACE="DejaVu Sans Mono">○ </FONT>material_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="technique_ru"><FONT FACE="DejaVu Sans Mono">○ </FONT>technique_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="height_mm"><FONT FACE="DejaVu Sans Mono">○ </FONT>height_mm</TD></TR><TR><TD ALIGN="LEFT" PORT="width_mm"><FONT FACE="DejaVu Sans Mono">○ </FONT>width_mm</TD></TR><TR><TD ALIGN="LEFT" PORT="depth_mm"><FONT FACE="DejaVu Sans Mono">○ </FONT>depth_mm</TD></TR><TR><TD ALIGN="LEFT" PORT="diameter_mm"><FONT FACE="DejaVu Sans Mono">○ </FONT>diameter_mm</TD></TR><TR><TD ALIGN="LEFT" PORT="weight_g"><FONT FACE="DejaVu Sans Mono">○ </FONT>weight_g</TD></TR><TR><TD ALIGN="LEFT" PORT="metal_fineness"><FONT FACE="DejaVu Sans Mono">○ </FONT>metal_fineness</TD></TR><TR><TD ALIGN="LEFT" PORT="pieces"><FONT FACE="DejaVu Sans Mono">∗ </FONT>pieces</TD></TR><TR><TD ALIGN="LEFT" PORT="signed"><FONT FACE="DejaVu Sans Mono">○ </FONT>signed</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "provenance" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>provenance</B><BR/>Происхождение вещей</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="item_id"><FONT FACE="DejaVu Sans Mono"># </FONT>item_id</TD></TR><TR><TD ALIGN="LEFT" PORT="seq"><FONT FACE="DejaVu Sans Mono"># </FONT>seq</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD ALIGN="LEFT" PORT="text_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>text_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="year_from"><FONT FACE="DejaVu Sans Mono">○ </FONT>year_from</TD></TR><TR><TD ALIGN="LEFT" PORT="year_to"><FONT FACE="DejaVu Sans Mono">○ </FONT>year_to</TD></TR><TR><TD ALIGN="LEFT" PORT="place_ru"><FONT FACE="DejaVu Sans Mono">○ </FONT>place_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="owner_name_ru"><FONT FACE="DejaVu Sans Mono">○ </FONT>owner_name_ru</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "consignments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>consignments</B><BR/>Договоры комиссии</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="consignor_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>consignor_id</TD></TR><TR><TD ALIGN="LEFT" PORT="office_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>office_id</TD></TR><TR><TD ALIGN="LEFT" PORT="specialist_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>specialist_id</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD ALIGN="LEFT" PORT="signed_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>signed_at</TD></TR><TR><TD ALIGN="LEFT" PORT="commission_schedule_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>commission_schedule_id</TD></TR><TR><TD ALIGN="LEFT" PORT="commission_rate"><FONT FACE="DejaVu Sans Mono">○ </FONT>commission_rate</TD></TR><TR><TD ALIGN="LEFT" PORT="dealer_discount"><FONT FACE="DejaVu Sans Mono">∗ </FONT>dealer_discount</TD></TR><TR><TD ALIGN="LEFT" PORT="unsold_policy"><FONT FACE="DejaVu Sans Mono">∗ </FONT>unsold_policy</TD></TR><TR><TD ALIGN="LEFT" PORT="expires_on"><FONT FACE="DejaVu Sans Mono">∗ </FONT>expires_on</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "consignment_items" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>consignment_items</B><BR/>Вещи в договорах</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="consignment_id"><FONT FACE="DejaVu Sans Mono"># </FONT>consignment_id</TD></TR><TR><TD ALIGN="LEFT" PORT="line_no"><FONT FACE="DejaVu Sans Mono"># </FONT>line_no</TD></TR><TR><TD ALIGN="LEFT" PORT="item_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>item_id</TD></TR><TR><TD ALIGN="LEFT" PORT="agreed_low"><FONT FACE="DejaVu Sans Mono">∗ </FONT>agreed_low</TD></TR><TR><TD ALIGN="LEFT" PORT="agreed_high"><FONT FACE="DejaVu Sans Mono">∗ </FONT>agreed_high</TD></TR><TR><TD ALIGN="LEFT" PORT="agreed_reserve"><FONT FACE="DejaVu Sans Mono">○ </FONT>agreed_reserve</TD></TR><TR><TD ALIGN="LEFT" PORT="ended_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>ended_at</TD></TR><TR><TD ALIGN="LEFT" PORT="outcome"><FONT FACE="DejaVu Sans Mono">○ </FONT>outcome</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
  }
  "departments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">departments<BR/>Отделы</FONT></TD></TR></TABLE>>];
  "categories" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">categories<BR/>Категории</FONT></TD></TR></TABLE>>];
  "offices" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">offices<BR/>Офисы</FONT></TD></TR></TABLE>>];
  "staff" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">staff<BR/>Сотрудники</FONT></TD></TR></TABLE>>];
  "fee_schedules" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">fee_schedules<BR/>Шкалы и сборы</FONT></TD></TR></TABLE>>];
  "clients" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">clients<BR/>Клиенты</FONT></TD></TR></TABLE>>];
  "departments" -> "makers":"department_id";
  "clients" -> "items":"consignor_id";
  "offices" -> "items":"office_id";
  "staff" -> "items":"specialist_id";
  "departments" -> "items":"department_id";
  "categories" -> "items":"category_id";
  "makers":"id" -> "items":"maker_id" [style=dashed];
  "items":"id" -> "provenance":"item_id";
  "clients" -> "consignments":"consignor_id";
  "offices" -> "consignments":"office_id";
  "staff" -> "consignments":"specialist_id";
  "fee_schedules" -> "consignments":"commission_schedule_id";
  "consignments":"id" -> "consignment_items":"consignment_id";
  "items":"id" -> "consignment_items":"item_id";
}
