// auc-data-v1 — группа «Деньги»: все поля её таблиц; таблицы других групп, на которые они ссылаются, — серой рамкой.
// Сгенерировано из описания схемы; руками не править. Картинка (SVG): tools/schema-svg.sh auc.
digraph schema {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.9, pad=0.3, splines=true, newrank=true];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [dir=both, arrowtail=none, arrowhead=crow, arrowsize=0.9, color="#333333"];
  subgraph "cluster_money" {
    label=<<B>Деньги</B>>;
    style="rounded,filled"; fillcolor="#ececec"; color="#bbbbbb"; margin=14;
    "invoices" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>invoices</B><BR/>Счета</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="number"><FONT FACE="DejaVu Sans Mono">∗ </FONT>number</TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>sale_id</TD></TR><TR><TD ALIGN="LEFT" PORT="registration_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>registration_id</TD></TR><TR><TD ALIGN="LEFT" PORT="client_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>client_id</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD ALIGN="LEFT" PORT="issued_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>issued_at</TD></TR><TR><TD ALIGN="LEFT" PORT="due_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>due_at</TD></TR><TR><TD ALIGN="LEFT" PORT="hammer_total"><FONT FACE="DejaVu Sans Mono">∗ </FONT>hammer_total</TD></TR><TR><TD ALIGN="LEFT" PORT="premium_total"><FONT FACE="DejaVu Sans Mono">∗ </FONT>premium_total</TD></TR><TR><TD ALIGN="LEFT" PORT="platform_fee_total"><FONT FACE="DejaVu Sans Mono">∗ </FONT>platform_fee_total</TD></TR><TR><TD ALIGN="LEFT" PORT="vat_total"><FONT FACE="DejaVu Sans Mono">∗ </FONT>vat_total</TD></TR><TR><TD ALIGN="LEFT" PORT="total"><FONT FACE="DejaVu Sans Mono">∗ </FONT>total</TD></TR><TR><TD ALIGN="LEFT" PORT="late_fee"><FONT FACE="DejaVu Sans Mono">∗ </FONT>late_fee</TD></TR><TR><TD ALIGN="LEFT" PORT="paid_total"><FONT FACE="DejaVu Sans Mono">∗ </FONT>paid_total</TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT FACE="DejaVu Sans Mono">∗ </FONT>status</TD></TR><TR><TD ALIGN="LEFT" PORT="paid_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>paid_at</TD></TR><TR><TD ALIGN="LEFT" PORT="cancelled_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>cancelled_at</TD></TR><TR><TD ALIGN="LEFT" PORT="cancel_reason"><FONT FACE="DejaVu Sans Mono">○ </FONT>cancel_reason</TD></TR><TR><TD ALIGN="LEFT" PORT="related_invoice_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>related_invoice_id</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "invoice_lines" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>invoice_lines</B><BR/>Строки счетов</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="invoice_id"><FONT FACE="DejaVu Sans Mono"># </FONT>invoice_id</TD></TR><TR><TD ALIGN="LEFT" PORT="line_no"><FONT FACE="DejaVu Sans Mono"># </FONT>line_no</TD></TR><TR><TD ALIGN="LEFT" PORT="lot_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>lot_id</TD></TR><TR><TD ALIGN="LEFT" PORT="price"><FONT FACE="DejaVu Sans Mono">∗ </FONT>price</TD></TR><TR><TD ALIGN="LEFT" PORT="premium_schedule_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>premium_schedule_id</TD></TR><TR><TD ALIGN="LEFT" PORT="premium"><FONT FACE="DejaVu Sans Mono">∗ </FONT>premium</TD></TR><TR><TD ALIGN="LEFT" PORT="platform_fee"><FONT FACE="DejaVu Sans Mono">∗ </FONT>platform_fee</TD></TR><TR><TD ALIGN="LEFT" PORT="vat_rate"><FONT FACE="DejaVu Sans Mono">∗ </FONT>vat_rate</TD></TR><TR><TD ALIGN="LEFT" PORT="vat"><FONT FACE="DejaVu Sans Mono">∗ </FONT>vat</TD></TR><TR><TD ALIGN="LEFT" PORT="line_total"><FONT FACE="DejaVu Sans Mono">∗ </FONT>line_total</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "payments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>payments</B><BR/>Платежи</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="client_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>client_id</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD ALIGN="LEFT" PORT="method"><FONT FACE="DejaVu Sans Mono">∗ </FONT>method</TD></TR><TR><TD ALIGN="LEFT" PORT="invoice_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>invoice_id</TD></TR><TR><TD ALIGN="LEFT" PORT="registration_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>registration_id</TD></TR><TR><TD ALIGN="LEFT" PORT="settlement_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>settlement_id</TD></TR><TR><TD ALIGN="LEFT" PORT="amount"><FONT FACE="DejaVu Sans Mono">∗ </FONT>amount</TD></TR><TR><TD ALIGN="LEFT" PORT="at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>at</TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT FACE="DejaVu Sans Mono">∗ </FONT>status</TD></TR><TR><TD ALIGN="LEFT" PORT="failure_reason"><FONT FACE="DejaVu Sans Mono">○ </FONT>failure_reason</TD></TR><TR><TD ALIGN="LEFT" PORT="provider_ref"><FONT FACE="DejaVu Sans Mono">○ </FONT>provider_ref</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "settlements" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>settlements</B><BR/>Отчёты комитентам</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>sale_id</TD></TR><TR><TD ALIGN="LEFT" PORT="consignor_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>consignor_id</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>created_at</TD></TR><TR><TD ALIGN="LEFT" PORT="hammer_total"><FONT FACE="DejaVu Sans Mono">∗ </FONT>hammer_total</TD></TR><TR><TD ALIGN="LEFT" PORT="commission_total"><FONT FACE="DejaVu Sans Mono">∗ </FONT>commission_total</TD></TR><TR><TD ALIGN="LEFT" PORT="fees_total"><FONT FACE="DejaVu Sans Mono">∗ </FONT>fees_total</TD></TR><TR><TD ALIGN="LEFT" PORT="vat_total"><FONT FACE="DejaVu Sans Mono">∗ </FONT>vat_total</TD></TR><TR><TD ALIGN="LEFT" PORT="net_total"><FONT FACE="DejaVu Sans Mono">∗ </FONT>net_total</TD></TR><TR><TD ALIGN="LEFT" PORT="paid_total"><FONT FACE="DejaVu Sans Mono">∗ </FONT>paid_total</TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT FACE="DejaVu Sans Mono">∗ </FONT>status</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "settlement_lines" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>settlement_lines</B><BR/>Строки отчётов</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="settlement_id"><FONT FACE="DejaVu Sans Mono"># </FONT>settlement_id</TD></TR><TR><TD ALIGN="LEFT" PORT="line_no"><FONT FACE="DejaVu Sans Mono"># </FONT>line_no</TD></TR><TR><TD ALIGN="LEFT" PORT="lot_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>lot_id</TD></TR><TR><TD ALIGN="LEFT" PORT="outcome"><FONT FACE="DejaVu Sans Mono">∗ </FONT>outcome</TD></TR><TR><TD ALIGN="LEFT" PORT="price"><FONT FACE="DejaVu Sans Mono">○ </FONT>price</TD></TR><TR><TD ALIGN="LEFT" PORT="commission"><FONT FACE="DejaVu Sans Mono">∗ </FONT>commission</TD></TR><TR><TD ALIGN="LEFT" PORT="insurance_fee"><FONT FACE="DejaVu Sans Mono">∗ </FONT>insurance_fee</TD></TR><TR><TD ALIGN="LEFT" PORT="catalogue_fee"><FONT FACE="DejaVu Sans Mono">∗ </FONT>catalogue_fee</TD></TR><TR><TD ALIGN="LEFT" PORT="withdrawal_fee"><FONT FACE="DejaVu Sans Mono">∗ </FONT>withdrawal_fee</TD></TR><TR><TD ALIGN="LEFT" PORT="vat"><FONT FACE="DejaVu Sans Mono">∗ </FONT>vat</TD></TR><TR><TD ALIGN="LEFT" PORT="net"><FONT FACE="DejaVu Sans Mono">∗ </FONT>net</TD></TR><TR><TD ALIGN="LEFT" PORT="payable_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>payable_at</TD></TR><TR><TD ALIGN="LEFT" PORT="paid_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>paid_at</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
  }
  "fee_schedules" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">fee_schedules<BR/>Шкалы и сборы</FONT></TD></TR></TABLE>>];
  "clients" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">clients<BR/>Клиенты</FONT></TD></TR></TABLE>>];
  "sales" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">sales<BR/>Торги</FONT></TD></TR></TABLE>>];
  "lots" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">lots<BR/>Лоты</FONT></TD></TR></TABLE>>];
  "registrations" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">registrations<BR/>Регистрации</FONT></TD></TR></TABLE>>];
  "sales" -> "invoices":"sale_id";
  "registrations" -> "invoices":"registration_id";
  "clients" -> "invoices":"client_id";
  "invoices":"id":e -> "invoices":"related_invoice_id":e [style=dashed];
  "invoices":"id" -> "invoice_lines":"invoice_id";
  "lots" -> "invoice_lines":"lot_id";
  "fee_schedules" -> "invoice_lines":"premium_schedule_id";
  "clients" -> "payments":"client_id";
  "invoices":"id" -> "payments":"invoice_id" [style=dashed];
  "registrations" -> "payments":"registration_id" [style=dashed];
  "settlements":"id" -> "payments":"settlement_id" [style=dashed];
  "sales" -> "settlements":"sale_id";
  "clients" -> "settlements":"consignor_id";
  "settlements":"id" -> "settlement_lines":"settlement_id";
  "lots" -> "settlement_lines":"lot_id";
}
