// auc-data-v1 — группа «Торги»: все поля её таблиц; таблицы других групп, на которые они ссылаются, — серой рамкой.
// Сгенерировано из описания схемы; руками не править. Картинка (SVG): tools/schema-svg.sh auc.
digraph schema {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.9, pad=0.3, splines=true, newrank=true];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [dir=both, arrowtail=none, arrowhead=crow, arrowsize=0.9, color="#333333"];
  subgraph "cluster_auction" {
    label=<<B>Торги</B>>;
    style="rounded,filled"; fillcolor="#ececec"; color="#bbbbbb"; margin=14;
    "sales" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>sales</B><BR/>Торги</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="code"><FONT FACE="DejaVu Sans Mono">∗ </FONT>code</TD></TR><TR><TD ALIGN="LEFT" PORT="format"><FONT FACE="DejaVu Sans Mono">∗ </FONT>format</TD></TR><TR><TD ALIGN="LEFT" PORT="tier"><FONT FACE="DejaVu Sans Mono">∗ </FONT>tier</TD></TR><TR><TD ALIGN="LEFT" PORT="department_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>department_id</TD></TR><TR><TD ALIGN="LEFT" PORT="office_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>office_id</TD></TR><TR><TD ALIGN="LEFT" PORT="title_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>title_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="title_en"><FONT FACE="DejaVu Sans Mono">∗ </FONT>title_en</TD></TR><TR><TD ALIGN="LEFT" PORT="published_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>published_at</TD></TR><TR><TD ALIGN="LEFT" PORT="bidding_opens_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>bidding_opens_at</TD></TR><TR><TD ALIGN="LEFT" PORT="preview_from"><FONT FACE="DejaVu Sans Mono">○ </FONT>preview_from</TD></TR><TR><TD ALIGN="LEFT" PORT="preview_to"><FONT FACE="DejaVu Sans Mono">○ </FONT>preview_to</TD></TR><TR><TD ALIGN="LEFT" PORT="starts_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>starts_at</TD></TR><TR><TD ALIGN="LEFT" PORT="ends_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>ends_at</TD></TR><TR><TD ALIGN="LEFT" PORT="lots_per_group"><FONT FACE="DejaVu Sans Mono">○ </FONT>lots_per_group</TD></TR><TR><TD ALIGN="LEFT" PORT="group_interval_s"><FONT FACE="DejaVu Sans Mono">○ </FONT>group_interval_s</TD></TR><TR><TD ALIGN="LEFT" PORT="extension_window_s"><FONT FACE="DejaVu Sans Mono">○ </FONT>extension_window_s</TD></TR><TR><TD ALIGN="LEFT" PORT="extension_s"><FONT FACE="DejaVu Sans Mono">○ </FONT>extension_s</TD></TR><TR><TD ALIGN="LEFT" PORT="extension_cap_s"><FONT FACE="DejaVu Sans Mono">○ </FONT>extension_cap_s</TD></TR><TR><TD ALIGN="LEFT" PORT="buyer_premium_schedule_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>buyer_premium_schedule_id</TD></TR><TR><TD ALIGN="LEFT" PORT="payment_due_days"><FONT FACE="DejaVu Sans Mono">∗ </FONT>payment_due_days</TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT FACE="DejaVu Sans Mono">∗ </FONT>status</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "sale_sessions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>sale_sessions</B><BR/>Сессии торгов</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><FONT FACE="DejaVu Sans Mono"># </FONT>sale_id</TD></TR><TR><TD ALIGN="LEFT" PORT="session_no"><FONT FACE="DejaVu Sans Mono"># </FONT>session_no</TD></TR><TR><TD ALIGN="LEFT" PORT="starts_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>starts_at</TD></TR><TR><TD ALIGN="LEFT" PORT="ended_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>ended_at</TD></TR><TR><TD ALIGN="LEFT" PORT="first_lot_no"><FONT FACE="DejaVu Sans Mono">∗ </FONT>first_lot_no</TD></TR><TR><TD ALIGN="LEFT" PORT="last_lot_no"><FONT FACE="DejaVu Sans Mono">∗ </FONT>last_lot_no</TD></TR><TR><TD ALIGN="LEFT" PORT="auctioneer_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>auctioneer_id</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "lots" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>lots</B><BR/>Лоты</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>sale_id</TD></TR><TR><TD ALIGN="LEFT" PORT="lot_no"><FONT FACE="DejaVu Sans Mono">∗ </FONT>lot_no</TD></TR><TR><TD ALIGN="LEFT" PORT="lot_label"><FONT FACE="DejaVu Sans Mono">∗ </FONT>lot_label</TD></TR><TR><TD ALIGN="LEFT" PORT="item_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>item_id</TD></TR><TR><TD ALIGN="LEFT" PORT="consignment_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>consignment_id</TD></TR><TR><TD ALIGN="LEFT" PORT="offering_no"><FONT FACE="DejaVu Sans Mono">∗ </FONT>offering_no</TD></TR><TR><TD ALIGN="LEFT" PORT="previous_lot_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>previous_lot_id</TD></TR><TR><TD ALIGN="LEFT" PORT="session_no"><FONT FACE="DejaVu Sans Mono">○ </FONT>session_no</TD></TR><TR><TD ALIGN="LEFT" PORT="published_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>published_at</TD></TR><TR><TD ALIGN="LEFT" PORT="low_estimate"><FONT FACE="DejaVu Sans Mono">∗ </FONT>low_estimate</TD></TR><TR><TD ALIGN="LEFT" PORT="high_estimate"><FONT FACE="DejaVu Sans Mono">∗ </FONT>high_estimate</TD></TR><TR><TD ALIGN="LEFT" PORT="starting_price"><FONT FACE="DejaVu Sans Mono">∗ </FONT>starting_price</TD></TR><TR><TD ALIGN="LEFT" PORT="reserve"><FONT FACE="DejaVu Sans Mono">○ </FONT>reserve</TD></TR><TR><TD ALIGN="LEFT" PORT="closes_at_planned"><FONT FACE="DejaVu Sans Mono">○ </FONT>closes_at_planned</TD></TR><TR><TD ALIGN="LEFT" PORT="opened_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>opened_at</TD></TR><TR><TD ALIGN="LEFT" PORT="closed_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>closed_at</TD></TR><TR><TD ALIGN="LEFT" PORT="closed_ms"><FONT FACE="DejaVu Sans Mono">○ </FONT>closed_ms</TD></TR><TR><TD ALIGN="LEFT" PORT="extensions"><FONT FACE="DejaVu Sans Mono">∗ </FONT>extensions</TD></TR><TR><TD ALIGN="LEFT" PORT="bid_count"><FONT FACE="DejaVu Sans Mono">∗ </FONT>bid_count</TD></TR><TR><TD ALIGN="LEFT" PORT="result"><FONT FACE="DejaVu Sans Mono">∗ </FONT>result</TD></TR><TR><TD ALIGN="LEFT" PORT="hammer_price"><FONT FACE="DejaVu Sans Mono">○ </FONT>hammer_price</TD></TR><TR><TD ALIGN="LEFT" PORT="winning_bid_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>winning_bid_id</TD></TR><TR><TD ALIGN="LEFT" PORT="buyer_registration_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>buyer_registration_id</TD></TR><TR><TD ALIGN="LEFT" PORT="underbidder_registration_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>underbidder_registration_id</TD></TR><TR><TD ALIGN="LEFT" PORT="after_sale_price"><FONT FACE="DejaVu Sans Mono">○ </FONT>after_sale_price</TD></TR><TR><TD ALIGN="LEFT" PORT="after_sale_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>after_sale_at</TD></TR><TR><TD ALIGN="LEFT" PORT="withdrawn_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>withdrawn_at</TD></TR><TR><TD ALIGN="LEFT" PORT="withdrawn_by"><FONT FACE="DejaVu Sans Mono">○ </FONT>withdrawn_by</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "registrations" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>registrations</B><BR/>Регистрации</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>sale_id</TD></TR><TR><TD ALIGN="LEFT" PORT="client_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>client_id</TD></TR><TR><TD ALIGN="LEFT" PORT="paddle_no"><FONT FACE="DejaVu Sans Mono">∗ </FONT>paddle_no</TD></TR><TR><TD ALIGN="LEFT" PORT="registered_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>registered_at</TD></TR><TR><TD ALIGN="LEFT" PORT="via"><FONT FACE="DejaVu Sans Mono">∗ </FONT>via</TD></TR><TR><TD ALIGN="LEFT" PORT="mode"><FONT FACE="DejaVu Sans Mono">∗ </FONT>mode</TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT FACE="DejaVu Sans Mono">∗ </FONT>status</TD></TR><TR><TD ALIGN="LEFT" PORT="decided_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>decided_at</TD></TR><TR><TD ALIGN="LEFT" PORT="decided_by_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>decided_by_id</TD></TR><TR><TD ALIGN="LEFT" PORT="reject_reason"><FONT FACE="DejaVu Sans Mono">○ </FONT>reject_reason</TD></TR><TR><TD ALIGN="LEFT" PORT="bid_limit"><FONT FACE="DejaVu Sans Mono">○ </FONT>bid_limit</TD></TR><TR><TD ALIGN="LEFT" PORT="premium_approved_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>premium_approved_at</TD></TR><TR><TD ALIGN="LEFT" PORT="deposit_required"><FONT FACE="DejaVu Sans Mono">○ </FONT>deposit_required</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "bid_orders" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>bid_orders</B><BR/>Поручения</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="lot_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>lot_id</TD></TR><TR><TD ALIGN="LEFT" PORT="registration_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>registration_id</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD ALIGN="LEFT" PORT="revision"><FONT FACE="DejaVu Sans Mono">∗ </FONT>revision</TD></TR><TR><TD ALIGN="LEFT" PORT="replaces_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>replaces_id</TD></TR><TR><TD ALIGN="LEFT" PORT="max_amount"><FONT FACE="DejaVu Sans Mono">○ </FONT>max_amount</TD></TR><TR><TD ALIGN="LEFT" PORT="placed_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>placed_at</TD></TR><TR><TD ALIGN="LEFT" PORT="placed_ms"><FONT FACE="DejaVu Sans Mono">∗ </FONT>placed_ms</TD></TR><TR><TD ALIGN="LEFT" PORT="via"><FONT FACE="DejaVu Sans Mono">∗ </FONT>via</TD></TR><TR><TD ALIGN="LEFT" PORT="revision_reason"><FONT FACE="DejaVu Sans Mono">○ </FONT>revision_reason</TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT FACE="DejaVu Sans Mono">∗ </FONT>status</TD></TR><TR><TD ALIGN="LEFT" PORT="ended_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>ended_at</TD></TR><TR><TD ALIGN="LEFT" PORT="phone_outcome"><FONT FACE="DejaVu Sans Mono">○ </FONT>phone_outcome</TD></TR><TR><TD ALIGN="LEFT" PORT="clerk_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>clerk_id</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "bids" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>bids</B><BR/>Ставки</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="lot_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>lot_id</TD></TR><TR><TD ALIGN="LEFT" PORT="seq"><FONT FACE="DejaVu Sans Mono">∗ </FONT>seq</TD></TR><TR><TD ALIGN="LEFT" PORT="registration_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>registration_id</TD></TR><TR><TD ALIGN="LEFT" PORT="channel"><FONT FACE="DejaVu Sans Mono">∗ </FONT>channel</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD ALIGN="LEFT" PORT="bid_order_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>bid_order_id</TD></TR><TR><TD ALIGN="LEFT" PORT="amount"><FONT FACE="DejaVu Sans Mono">∗ </FONT>amount</TD></TR><TR><TD ALIGN="LEFT" PORT="placed_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>placed_at</TD></TR><TR><TD ALIGN="LEFT" PORT="placed_ms"><FONT FACE="DejaVu Sans Mono">∗ </FONT>placed_ms</TD></TR><TR><TD ALIGN="LEFT" PORT="accepted"><FONT FACE="DejaVu Sans Mono">∗ </FONT>accepted</TD></TR><TR><TD ALIGN="LEFT" PORT="reject_reason"><FONT FACE="DejaVu Sans Mono">○ </FONT>reject_reason</TD></TR><TR><TD ALIGN="LEFT" PORT="extended_close"><FONT FACE="DejaVu Sans Mono">∗ </FONT>extended_close</TD></TR><TR><TD ALIGN="LEFT" PORT="request_key"><FONT FACE="DejaVu Sans Mono">○ </FONT>request_key</TD></TR><TR><TD ALIGN="LEFT" PORT="clerk_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>clerk_id</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "lot_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>lot_events</B><BR/>События лотов</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="lot_id"><FONT FACE="DejaVu Sans Mono"># </FONT>lot_id</TD></TR><TR><TD ALIGN="LEFT" PORT="seq"><FONT FACE="DejaVu Sans Mono"># </FONT>seq</TD></TR><TR><TD ALIGN="LEFT" PORT="at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>at</TD></TR><TR><TD ALIGN="LEFT" PORT="at_ms"><FONT FACE="DejaVu Sans Mono">∗ </FONT>at_ms</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD ALIGN="LEFT" PORT="bid_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>bid_id</TD></TR><TR><TD ALIGN="LEFT" PORT="new_close_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>new_close_at</TD></TR><TR><TD ALIGN="LEFT" PORT="new_close_ms"><FONT FACE="DejaVu Sans Mono">○ </FONT>new_close_ms</TD></TR><TR><TD ALIGN="LEFT" PORT="price"><FONT FACE="DejaVu Sans Mono">○ </FONT>price</TD></TR><TR><TD ALIGN="LEFT" PORT="staff_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>staff_id</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "item_status_log" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>item_status_log</B><BR/>Статусы вещей</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="item_id"><FONT FACE="DejaVu Sans Mono"># </FONT>item_id</TD></TR><TR><TD ALIGN="LEFT" PORT="seq"><FONT FACE="DejaVu Sans Mono"># </FONT>seq</TD></TR><TR><TD ALIGN="LEFT" PORT="at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>at</TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT FACE="DejaVu Sans Mono">∗ </FONT>status</TD></TR><TR><TD ALIGN="LEFT" PORT="lot_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>lot_id</TD></TR><TR><TD ALIGN="LEFT" PORT="consignment_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>consignment_id</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
  }
  "departments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">departments<BR/>Отделы</FONT></TD></TR></TABLE>>];
  "offices" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">offices<BR/>Офисы</FONT></TD></TR></TABLE>>];
  "staff" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">staff<BR/>Сотрудники</FONT></TD></TR></TABLE>>];
  "fee_schedules" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">fee_schedules<BR/>Шкалы и сборы</FONT></TD></TR></TABLE>>];
  "items" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">items<BR/>Вещи</FONT></TD></TR></TABLE>>];
  "consignments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">consignments<BR/>Договоры комиссии</FONT></TD></TR></TABLE>>];
  "clients" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">clients<BR/>Клиенты</FONT></TD></TR></TABLE>>];
  "departments" -> "sales":"department_id";
  "offices" -> "sales":"office_id";
  "fee_schedules" -> "sales":"buyer_premium_schedule_id";
  "sales":"id" -> "sale_sessions":"sale_id";
  "staff" -> "sale_sessions":"auctioneer_id";
  "sales":"id" -> "lots":"sale_id";
  "items" -> "lots":"item_id";
  "consignments" -> "lots":"consignment_id";
  "lots":"id":e -> "lots":"previous_lot_id":e [style=dashed];
  "bids":"id" -> "lots":"winning_bid_id" [style=dashed];
  "registrations":"id" -> "lots":"buyer_registration_id" [style=dashed];
  "registrations":"id" -> "lots":"underbidder_registration_id" [style=dashed];
  "sale_sessions":"session_no" -> "lots":"session_no" [style=dashed];
  "sales":"id" -> "registrations":"sale_id";
  "clients" -> "registrations":"client_id";
  "staff" -> "registrations":"decided_by_id" [style=dashed];
  "lots":"id" -> "bid_orders":"lot_id";
  "registrations":"id" -> "bid_orders":"registration_id";
  "bid_orders":"id":e -> "bid_orders":"replaces_id":e [style=dashed];
  "staff" -> "bid_orders":"clerk_id" [style=dashed];
  "lots":"id" -> "bids":"lot_id";
  "registrations":"id" -> "bids":"registration_id" [style=dashed];
  "bid_orders":"id" -> "bids":"bid_order_id" [style=dashed];
  "staff" -> "bids":"clerk_id" [style=dashed];
  "lots":"id" -> "lot_events":"lot_id";
  "bids":"id" -> "lot_events":"bid_id" [style=dashed];
  "staff" -> "lot_events":"staff_id" [style=dashed];
  "items" -> "item_status_log":"item_id";
  "lots":"id" -> "item_status_log":"lot_id" [style=dashed];
  "consignments" -> "item_status_log":"consignment_id" [style=dashed];
}
