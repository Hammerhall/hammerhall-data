# среда разработки
.idea/
*.iml
.vscode/

# система
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.pyc
.venv/

# данные — только в выпусках GitHub, не в git
*.tsv
*.tsv.gz
*.sql
*.sql.gz
*.rar
*.duckdb
*.duckdb.wal
# папки выпусков любого набора (<код>-data-vN, <код>-data-vN-small) и рабочие папки сборки авиа
*-data-v*/
air-build-*/

# исключения из правила «данные — не в git» (у любого набора <код>/): справочники генератора (маленькие, исходники
# мира), схема выпуска (DDL — из описания схемы; тест и CI сверяют её с генератором), контрольные запросы pg-check
!*/src/main/resources/**/*.tsv
!*/schema/*.sql
!*/pg-check.sql
# генератор авиа (air/gen — изменённая копия демобазы): его SQL и входы сети — исходники, не данные
!air/gen/**/*.sql
!air/gen/**/*.tsv

# сборка (build.sh — target/<код>/, Maven — <модуль>/target/) и рабочие прогоны (входы наборов — <код>/work/)
target/
work/
