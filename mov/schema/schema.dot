// mov-data-v1 — схема: все таблицы со всеми полями, группы — рамками.
// Сгенерировано из описания схемы; руками не править. Картинка (SVG): tools/schema-svg.sh mov.
digraph schema {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.9, pad=0.3, splines=true, newrank=true];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [dir=both, arrowtail=none, arrowhead=crow, arrowsize=0.9, color="#333333"];
  subgraph "cluster_cinema" {
    label=<<B>Кино</B>>;
    style="rounded,filled"; fillcolor="#ececec"; color="#bbbbbb"; margin=14;
    "genres" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>genres</B><BR/>Жанры</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "movies" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>movies</B><BR/>Фильмы</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="title"><FONT FACE="DejaVu Sans Mono">∗ </FONT>title</TD></TR><TR><TD ALIGN="LEFT" PORT="title_ru"><FONT FACE="DejaVu Sans Mono">○ </FONT>title_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="year"><FONT FACE="DejaVu Sans Mono">∗ </FONT>year</TD></TR><TR><TD ALIGN="LEFT" PORT="release_date"><FONT FACE="DejaVu Sans Mono">○ </FONT>release_date</TD></TR><TR><TD ALIGN="LEFT" PORT="runtime"><FONT FACE="DejaVu Sans Mono">○ </FONT>runtime</TD></TR><TR><TD ALIGN="LEFT" PORT="rank"><FONT FACE="DejaVu Sans Mono">∗ </FONT>rank</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "actors" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>actors</B><BR/>Актёры</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="first_name"><FONT FACE="DejaVu Sans Mono">○ </FONT>first_name</TD></TR><TR><TD ALIGN="LEFT" PORT="last_name"><FONT FACE="DejaVu Sans Mono">∗ </FONT>last_name</TD></TR><TR><TD ALIGN="LEFT" PORT="gender"><FONT FACE="DejaVu Sans Mono">∗ </FONT>gender</TD></TR><TR><TD ALIGN="LEFT" PORT="name_ru"><FONT FACE="DejaVu Sans Mono">○ </FONT>name_ru</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "directors" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>directors</B><BR/>Режиссёры</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="first_name"><FONT FACE="DejaVu Sans Mono">○ </FONT>first_name</TD></TR><TR><TD ALIGN="LEFT" PORT="last_name"><FONT FACE="DejaVu Sans Mono">∗ </FONT>last_name</TD></TR><TR><TD ALIGN="LEFT" PORT="name_ru"><FONT FACE="DejaVu Sans Mono">○ </FONT>name_ru</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "roles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>roles</B><BR/>Роли</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="actor_id"><FONT FACE="DejaVu Sans Mono"># </FONT>actor_id</TD></TR><TR><TD ALIGN="LEFT" PORT="movie_id"><FONT FACE="DejaVu Sans Mono"># </FONT>movie_id</TD></TR><TR><TD ALIGN="LEFT" PORT="role"><FONT FACE="DejaVu Sans Mono">○ </FONT>role</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "movies_directors" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>movies_directors</B><BR/>Режиссёры фильмов</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="director_id"><FONT FACE="DejaVu Sans Mono"># </FONT>director_id</TD></TR><TR><TD ALIGN="LEFT" PORT="movie_id"><FONT FACE="DejaVu Sans Mono"># </FONT>movie_id</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "movies_genres" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>movies_genres</B><BR/>Жанры фильмов</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="movie_id"><FONT FACE="DejaVu Sans Mono"># </FONT>movie_id</TD></TR><TR><TD ALIGN="LEFT" PORT="genre_id"><FONT FACE="DejaVu Sans Mono"># </FONT>genre_id</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "directors_genres" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>directors_genres</B><BR/>Жанры режиссёров</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="director_id"><FONT FACE="DejaVu Sans Mono"># </FONT>director_id</TD></TR><TR><TD ALIGN="LEFT" PORT="genre_id"><FONT FACE="DejaVu Sans Mono"># </FONT>genre_id</TD></TR><TR><TD ALIGN="LEFT" PORT="prob"><FONT FACE="DejaVu Sans Mono">∗ </FONT>prob</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "movies_countries" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>movies_countries</B><BR/>Страны фильмов</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="movie_id"><FONT FACE="DejaVu Sans Mono"># </FONT>movie_id</TD></TR><TR><TD ALIGN="LEFT" PORT="country_code"><FONT FACE="DejaVu Sans Mono"># </FONT>country_code</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "movies_languages" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>movies_languages</B><BR/>Языки фильмов</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="movie_id"><FONT FACE="DejaVu Sans Mono"># </FONT>movie_id</TD></TR><TR><TD ALIGN="LEFT" PORT="language_code"><FONT FACE="DejaVu Sans Mono"># </FONT>language_code</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
  }
  "actors":"id" -> "roles":"actor_id";
  "movies":"id" -> "roles":"movie_id";
  "directors":"id" -> "movies_directors":"director_id";
  "movies":"id" -> "movies_directors":"movie_id";
  "movies":"id" -> "movies_genres":"movie_id";
  "genres":"id" -> "movies_genres":"genre_id";
  "directors":"id" -> "directors_genres":"director_id";
  "genres":"id" -> "directors_genres":"genre_id";
  "movies":"id" -> "movies_countries":"movie_id";
  "movies":"id" -> "movies_languages":"movie_id";
}
