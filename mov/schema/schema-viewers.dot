// mov-data-v1 — группа «Зрители»: все поля её таблиц; таблицы других групп, на которые они ссылаются, — серой рамкой.
// Сгенерировано из описания схемы; руками не править. Картинка (SVG): tools/schema-svg.sh mov.
digraph schema {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.9, pad=0.3, splines=true, newrank=true];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [dir=both, arrowtail=none, arrowhead=crow, arrowsize=0.9, color="#333333"];
  subgraph "cluster_viewers" {
    label=<<B>Зрители</B>>;
    style="rounded,filled"; fillcolor="#ececec"; color="#bbbbbb"; margin=14;
    "users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>users</B><BR/>Пользователи</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="login"><FONT FACE="DejaVu Sans Mono">∗ </FONT>login</TD></TR><TR><TD ALIGN="LEFT" PORT="display_name"><FONT FACE="DejaVu Sans Mono">∗ </FONT>display_name</TD></TR><TR><TD ALIGN="LEFT" PORT="gender"><FONT FACE="DejaVu Sans Mono">∗ </FONT>gender</TD></TR><TR><TD ALIGN="LEFT" PORT="birth_year"><FONT FACE="DejaVu Sans Mono">∗ </FONT>birth_year</TD></TR><TR><TD ALIGN="LEFT" PORT="city_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>city_id</TD></TR><TR><TD ALIGN="LEFT" PORT="registered_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>registered_at</TD></TR><TR><TD ALIGN="LEFT" PORT="channel"><FONT FACE="DejaVu Sans Mono">∗ </FONT>channel</TD></TR><TR><TD ALIGN="LEFT" PORT="referrer_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>referrer_id</TD></TR><TR><TD ALIGN="LEFT" PORT="promo_code_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>promo_code_id</TD></TR><TR><TD ALIGN="LEFT" PORT="deleted_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>deleted_at</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "devices" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>devices</B><BR/>Устройства</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>user_id</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD ALIGN="LEFT" PORT="os"><FONT FACE="DejaVu Sans Mono">∗ </FONT>os</TD></TR><TR><TD ALIGN="LEFT" PORT="first_seen_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>first_seen_at</TD></TR><TR><TD ALIGN="LEFT" PORT="last_seen_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>last_seen_at</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "subscriptions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>subscriptions</B><BR/>Подписки</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>user_id</TD></TR><TR><TD ALIGN="LEFT" PORT="plan_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>plan_id</TD></TR><TR><TD ALIGN="LEFT" PORT="started_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>started_at</TD></TR><TR><TD ALIGN="LEFT" PORT="trial_ends_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>trial_ends_at</TD></TR><TR><TD ALIGN="LEFT" PORT="ends_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>ends_at</TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT FACE="DejaVu Sans Mono">∗ </FONT>status</TD></TR><TR><TD ALIGN="LEFT" PORT="auto_renew"><FONT FACE="DejaVu Sans Mono">∗ </FONT>auto_renew</TD></TR><TR><TD ALIGN="LEFT" PORT="cancelled_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>cancelled_at</TD></TR><TR><TD ALIGN="LEFT" PORT="cancel_reason"><FONT FACE="DejaVu Sans Mono">○ </FONT>cancel_reason</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "payments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>payments</B><BR/>Оплаты</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>user_id</TD></TR><TR><TD ALIGN="LEFT" PORT="subscription_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>subscription_id</TD></TR><TR><TD ALIGN="LEFT" PORT="purchase_id"><FONT FACE="DejaVu Sans Mono">○ </FONT>purchase_id</TD></TR><TR><TD ALIGN="LEFT" PORT="amount_rub"><FONT FACE="DejaVu Sans Mono">∗ </FONT>amount_rub</TD></TR><TR><TD ALIGN="LEFT" PORT="method"><FONT FACE="DejaVu Sans Mono">∗ </FONT>method</TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT FACE="DejaVu Sans Mono">∗ </FONT>status</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>created_at</TD></TR><TR><TD ALIGN="LEFT" PORT="refunded_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>refunded_at</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "purchases" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>purchases</B><BR/>Покупки</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>user_id</TD></TR><TR><TD ALIGN="LEFT" PORT="movie_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>movie_id</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD ALIGN="LEFT" PORT="price_rub"><FONT FACE="DejaVu Sans Mono">∗ </FONT>price_rub</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>created_at</TD></TR><TR><TD ALIGN="LEFT" PORT="expires_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>expires_at</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "views" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>views</B><BR/>Просмотры</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>user_id</TD></TR><TR><TD ALIGN="LEFT" PORT="device_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>device_id</TD></TR><TR><TD ALIGN="LEFT" PORT="movie_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>movie_id</TD></TR><TR><TD ALIGN="LEFT" PORT="started_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>started_at</TD></TR><TR><TD ALIGN="LEFT" PORT="watched_min"><FONT FACE="DejaVu Sans Mono">∗ </FONT>watched_min</TD></TR><TR><TD ALIGN="LEFT" PORT="completed"><FONT FACE="DejaVu Sans Mono">∗ </FONT>completed</TD></TR><TR><TD ALIGN="LEFT" PORT="quality"><FONT FACE="DejaVu Sans Mono">∗ </FONT>quality</TD></TR><TR><TD ALIGN="LEFT" PORT="source"><FONT FACE="DejaVu Sans Mono">∗ </FONT>source</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
  }
  "movies" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">movies<BR/>Фильмы</FONT></TD></TR></TABLE>>];
  "plans" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">plans<BR/>Тарифы</FONT></TD></TR></TABLE>>];
  "promo_codes" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">promo_codes<BR/>Промокоды</FONT></TD></TR></TABLE>>];
  "users":"id":e -> "users":"referrer_id":e [style=dashed];
  "promo_codes" -> "users":"promo_code_id" [style=dashed];
  "users":"id" -> "devices":"user_id";
  "users":"id" -> "subscriptions":"user_id";
  "plans" -> "subscriptions":"plan_id";
  "users":"id" -> "payments":"user_id";
  "subscriptions":"id" -> "payments":"subscription_id" [style=dashed];
  "purchases":"id" -> "payments":"purchase_id" [style=dashed];
  "users":"id" -> "purchases":"user_id";
  "movies" -> "purchases":"movie_id";
  "users":"id" -> "views":"user_id";
  "devices":"id" -> "views":"device_id";
  "movies" -> "views":"movie_id";
}
