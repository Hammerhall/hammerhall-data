// mov-data-v1 — группа «Сервис»: все поля её таблиц; таблицы других групп, на которые они ссылаются, — серой рамкой.
// Сгенерировано из описания схемы; руками не править. Картинка (SVG): tools/schema-svg.sh mov.
digraph schema {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.9, pad=0.3, splines=true, newrank=true];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [dir=both, arrowtail=none, arrowhead=crow, arrowsize=0.9, color="#333333"];
  subgraph "cluster_service" {
    label=<<B>Сервис</B>>;
    style="rounded,filled"; fillcolor="#ececec"; color="#bbbbbb"; margin=14;
    "plans" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>plans</B><BR/>Тарифы</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="code"><FONT FACE="DejaVu Sans Mono">∗ </FONT>code</TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name</TD></TR><TR><TD ALIGN="LEFT" PORT="monthly_rub"><FONT FACE="DejaVu Sans Mono">∗ </FONT>monthly_rub</TD></TR><TR><TD ALIGN="LEFT" PORT="period_months"><FONT FACE="DejaVu Sans Mono">∗ </FONT>period_months</TD></TR><TR><TD ALIGN="LEFT" PORT="max_streams"><FONT FACE="DejaVu Sans Mono">∗ </FONT>max_streams</TD></TR><TR><TD ALIGN="LEFT" PORT="max_quality"><FONT FACE="DejaVu Sans Mono">∗ </FONT>max_quality</TD></TR><TR><TD ALIGN="LEFT" PORT="ads"><FONT FACE="DejaVu Sans Mono">∗ </FONT>ads</TD></TR><TR><TD ALIGN="LEFT" PORT="introduced_on"><FONT FACE="DejaVu Sans Mono">∗ </FONT>introduced_on</TD></TR><TR><TD ALIGN="LEFT" PORT="retired_on"><FONT FACE="DejaVu Sans Mono">○ </FONT>retired_on</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "plan_prices" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>plan_prices</B><BR/>Цены тарифов</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="plan_id"><FONT FACE="DejaVu Sans Mono"># </FONT>plan_id</TD></TR><TR><TD ALIGN="LEFT" PORT="valid_from"><FONT FACE="DejaVu Sans Mono"># </FONT>valid_from</TD></TR><TR><TD ALIGN="LEFT" PORT="price_rub"><FONT FACE="DejaVu Sans Mono">∗ </FONT>price_rub</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "promo_codes" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>promo_codes</B><BR/>Промокоды</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="code"><FONT FACE="DejaVu Sans Mono">∗ </FONT>code</TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT FACE="DejaVu Sans Mono">∗ </FONT>kind</TD></TR><TR><TD ALIGN="LEFT" PORT="value"><FONT FACE="DejaVu Sans Mono">∗ </FONT>value</TD></TR><TR><TD ALIGN="LEFT" PORT="partner"><FONT FACE="DejaVu Sans Mono">∗ </FONT>partner</TD></TR><TR><TD ALIGN="LEFT" PORT="valid_from"><FONT FACE="DejaVu Sans Mono">∗ </FONT>valid_from</TD></TR><TR><TD ALIGN="LEFT" PORT="valid_to"><FONT FACE="DejaVu Sans Mono">∗ </FONT>valid_to</TD></TR><TR><TD ALIGN="LEFT" PORT="max_uses"><FONT FACE="DejaVu Sans Mono">○ </FONT>max_uses</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "catalog" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>catalog</B><BR/>Каталог</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="movie_id"><FONT FACE="DejaVu Sans Mono"># </FONT>movie_id</TD></TR><TR><TD ALIGN="LEFT" PORT="added_at"><FONT FACE="DejaVu Sans Mono"># </FONT>added_at</TD></TR><TR><TD ALIGN="LEFT" PORT="removed_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>removed_at</TD></TR><TR><TD ALIGN="LEFT" PORT="access"><FONT FACE="DejaVu Sans Mono">∗ </FONT>access</TD></TR><TR><TD ALIGN="LEFT" PORT="rent_price_rub"><FONT FACE="DejaVu Sans Mono">○ </FONT>rent_price_rub</TD></TR><TR><TD ALIGN="LEFT" PORT="buy_price_rub"><FONT FACE="DejaVu Sans Mono">○ </FONT>buy_price_rub</TD></TR><TR><TD ALIGN="LEFT" PORT="subscription_from"><FONT FACE="DejaVu Sans Mono">○ </FONT>subscription_from</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
  }
  "movies" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">movies<BR/>Фильмы</FONT></TD></TR></TABLE>>];
  "plans":"id" -> "plan_prices":"plan_id";
  "movies" -> "catalog":"movie_id";
}
