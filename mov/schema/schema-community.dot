// mov-data-v1 — группа «Сообщество»: все поля её таблиц; таблицы других групп, на которые они ссылаются, — серой рамкой.
// Сгенерировано из описания схемы; руками не править. Картинка (SVG): tools/schema-svg.sh mov.
digraph schema {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.9, pad=0.3, splines=true, newrank=true];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [dir=both, arrowtail=none, arrowhead=crow, arrowsize=0.9, color="#333333"];
  subgraph "cluster_community" {
    label=<<B>Сообщество</B>>;
    style="rounded,filled"; fillcolor="#ececec"; color="#bbbbbb"; margin=14;
    "ratings" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>ratings</B><BR/>Оценки</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT FACE="DejaVu Sans Mono"># </FONT>user_id</TD></TR><TR><TD ALIGN="LEFT" PORT="movie_id"><FONT FACE="DejaVu Sans Mono"># </FONT>movie_id</TD></TR><TR><TD ALIGN="LEFT" PORT="rating"><FONT FACE="DejaVu Sans Mono">∗ </FONT>rating</TD></TR><TR><TD ALIGN="LEFT" PORT="rated_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>rated_at</TD></TR><TR><TD ALIGN="LEFT" PORT="changes"><FONT FACE="DejaVu Sans Mono">∗ </FONT>changes</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "reviews" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>reviews</B><BR/>Рецензии</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>user_id</TD></TR><TR><TD ALIGN="LEFT" PORT="movie_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>movie_id</TD></TR><TR><TD ALIGN="LEFT" PORT="rating"><FONT FACE="DejaVu Sans Mono">∗ </FONT>rating</TD></TR><TR><TD ALIGN="LEFT" PORT="title"><FONT FACE="DejaVu Sans Mono">∗ </FONT>title</TD></TR><TR><TD ALIGN="LEFT" PORT="body"><FONT FACE="DejaVu Sans Mono">∗ </FONT>body</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>created_at</TD></TR><TR><TD ALIGN="LEFT" PORT="edited_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>edited_at</TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT FACE="DejaVu Sans Mono">∗ </FONT>status</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "review_votes" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>review_votes</B><BR/>Голоса за рецензии</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="review_id"><FONT FACE="DejaVu Sans Mono"># </FONT>review_id</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT FACE="DejaVu Sans Mono"># </FONT>user_id</TD></TR><TR><TD ALIGN="LEFT" PORT="useful"><FONT FACE="DejaVu Sans Mono">∗ </FONT>useful</TD></TR><TR><TD ALIGN="LEFT" PORT="voted_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>voted_at</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "watchlist" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>watchlist</B><BR/>Списки «посмотреть»</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT FACE="DejaVu Sans Mono"># </FONT>user_id</TD></TR><TR><TD ALIGN="LEFT" PORT="movie_id"><FONT FACE="DejaVu Sans Mono"># </FONT>movie_id</TD></TR><TR><TD ALIGN="LEFT" PORT="added_at"><FONT FACE="DejaVu Sans Mono"># </FONT>added_at</TD></TR><TR><TD ALIGN="LEFT" PORT="removed_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>removed_at</TD></TR><TR><TD ALIGN="LEFT" PORT="removed_reason"><FONT FACE="DejaVu Sans Mono">○ </FONT>removed_reason</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "follows" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>follows</B><BR/>Подписки на людей</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="follower_id"><FONT FACE="DejaVu Sans Mono"># </FONT>follower_id</TD></TR><TR><TD ALIGN="LEFT" PORT="followee_id"><FONT FACE="DejaVu Sans Mono"># </FONT>followee_id</TD></TR><TR><TD ALIGN="LEFT" PORT="followed_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>followed_at</TD></TR><TR><TD ALIGN="LEFT" PORT="unfollowed_at"><FONT FACE="DejaVu Sans Mono">○ </FONT>unfollowed_at</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "collections" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>collections</B><BR/>Подборки</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>user_id</TD></TR><TR><TD ALIGN="LEFT" PORT="title"><FONT FACE="DejaVu Sans Mono">∗ </FONT>title</TD></TR><TR><TD ALIGN="LEFT" PORT="is_public"><FONT FACE="DejaVu Sans Mono">∗ </FONT>is_public</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>created_at</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "collection_items" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>collection_items</B><BR/>Фильмы подборок</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="collection_id"><FONT FACE="DejaVu Sans Mono"># </FONT>collection_id</TD></TR><TR><TD ALIGN="LEFT" PORT="movie_id"><FONT FACE="DejaVu Sans Mono"># </FONT>movie_id</TD></TR><TR><TD ALIGN="LEFT" PORT="position"><FONT FACE="DejaVu Sans Mono">∗ </FONT>position</TD></TR><TR><TD ALIGN="LEFT" PORT="added_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>added_at</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "tags" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>tags</B><BR/>Теги</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT FACE="DejaVu Sans Mono"># </FONT>id</TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "movie_tags" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>movie_tags</B><BR/>Теги фильмов</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT FACE="DejaVu Sans Mono"># </FONT>user_id</TD></TR><TR><TD ALIGN="LEFT" PORT="movie_id"><FONT FACE="DejaVu Sans Mono"># </FONT>movie_id</TD></TR><TR><TD ALIGN="LEFT" PORT="tag_id"><FONT FACE="DejaVu Sans Mono"># </FONT>tag_id</TD></TR><TR><TD ALIGN="LEFT" PORT="tagged_at"><FONT FACE="DejaVu Sans Mono">∗ </FONT>tagged_at</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
  }
  "movies" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">movies<BR/>Фильмы</FONT></TD></TR></TABLE>>];
  "users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999" BGCOLOR="white"><TR><TD><FONT COLOR="#666666">users<BR/>Пользователи</FONT></TD></TR></TABLE>>];
  "users" -> "ratings":"user_id";
  "movies" -> "ratings":"movie_id";
  "users" -> "reviews":"user_id";
  "movies" -> "reviews":"movie_id";
  "reviews":"id" -> "review_votes":"review_id";
  "users" -> "review_votes":"user_id";
  "users" -> "watchlist":"user_id";
  "movies" -> "watchlist":"movie_id";
  "users" -> "follows":"follower_id";
  "users" -> "follows":"followee_id";
  "users" -> "collections":"user_id";
  "collections":"id" -> "collection_items":"collection_id";
  "movies" -> "collection_items":"movie_id";
  "users" -> "movie_tags":"user_id";
  "movies" -> "movie_tags":"movie_id";
  "tags":"id" -> "movie_tags":"tag_id";
}
