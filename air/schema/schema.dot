// air-data-v1 — схема: все таблицы со всеми полями, группы — рамками.
// Сгенерировано из описания схемы; руками не править. Картинка (SVG): tools/schema-svg.sh air.
digraph schema {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.9, pad=0.3, splines=true, newrank=true];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [dir=both, arrowtail=none, arrowhead=crow, arrowsize=0.9, color="#333333"];
  subgraph "cluster_network" {
    label=<<B>Сеть</B>>;
    style="rounded,filled"; fillcolor="#ececec"; color="#bbbbbb"; margin=14;
    "airports" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>airports</B><BR/>Аэропорты</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="airport_code"><FONT FACE="DejaVu Sans Mono"># </FONT>airport_code</TD></TR><TR><TD ALIGN="LEFT" PORT="name_en"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_en</TD></TR><TR><TD ALIGN="LEFT" PORT="name_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>name_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="city_en"><FONT FACE="DejaVu Sans Mono">∗ </FONT>city_en</TD></TR><TR><TD ALIGN="LEFT" PORT="city_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>city_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="country_en"><FONT FACE="DejaVu Sans Mono">∗ </FONT>country_en</TD></TR><TR><TD ALIGN="LEFT" PORT="country_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>country_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="longitude"><FONT FACE="DejaVu Sans Mono">∗ </FONT>longitude</TD></TR><TR><TD ALIGN="LEFT" PORT="latitude"><FONT FACE="DejaVu Sans Mono">∗ </FONT>latitude</TD></TR><TR><TD ALIGN="LEFT" PORT="timezone"><FONT FACE="DejaVu Sans Mono">∗ </FONT>timezone</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "airplanes" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>airplanes</B><BR/>Самолёты</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="airplane_code"><FONT FACE="DejaVu Sans Mono"># </FONT>airplane_code</TD></TR><TR><TD ALIGN="LEFT" PORT="model_en"><FONT FACE="DejaVu Sans Mono">∗ </FONT>model_en</TD></TR><TR><TD ALIGN="LEFT" PORT="model_ru"><FONT FACE="DejaVu Sans Mono">∗ </FONT>model_ru</TD></TR><TR><TD ALIGN="LEFT" PORT="range_km"><FONT FACE="DejaVu Sans Mono">∗ </FONT>range_km</TD></TR><TR><TD ALIGN="LEFT" PORT="speed_kmh"><FONT FACE="DejaVu Sans Mono">∗ </FONT>speed_kmh</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "seats" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>seats</B><BR/>Места</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="airplane_code"><FONT FACE="DejaVu Sans Mono"># </FONT>airplane_code</TD></TR><TR><TD ALIGN="LEFT" PORT="seat_no"><FONT FACE="DejaVu Sans Mono"># </FONT>seat_no</TD></TR><TR><TD ALIGN="LEFT" PORT="fare_conditions"><FONT FACE="DejaVu Sans Mono">∗ </FONT>fare_conditions</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "routes" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>routes</B><BR/>Маршруты</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="route_no"><FONT FACE="DejaVu Sans Mono"># </FONT>route_no</TD></TR><TR><TD ALIGN="LEFT" PORT="valid_from"><FONT FACE="DejaVu Sans Mono"># </FONT>valid_from</TD></TR><TR><TD ALIGN="LEFT" PORT="valid_to"><FONT FACE="DejaVu Sans Mono">∗ </FONT>valid_to</TD></TR><TR><TD ALIGN="LEFT" PORT="departure_airport"><FONT FACE="DejaVu Sans Mono">∗ </FONT>departure_airport</TD></TR><TR><TD ALIGN="LEFT" PORT="arrival_airport"><FONT FACE="DejaVu Sans Mono">∗ </FONT>arrival_airport</TD></TR><TR><TD ALIGN="LEFT" PORT="airplane_code"><FONT FACE="DejaVu Sans Mono">∗ </FONT>airplane_code</TD></TR><TR><TD ALIGN="LEFT" PORT="days_of_week"><FONT FACE="DejaVu Sans Mono">∗ </FONT>days_of_week</TD></TR><TR><TD ALIGN="LEFT" PORT="scheduled_time"><FONT FACE="DejaVu Sans Mono">∗ </FONT>scheduled_time</TD></TR><TR><TD ALIGN="LEFT" PORT="duration_min"><FONT FACE="DejaVu Sans Mono">∗ </FONT>duration_min</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "flights" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>flights</B><BR/>Рейсы</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="flight_id"><FONT FACE="DejaVu Sans Mono"># </FONT>flight_id</TD></TR><TR><TD ALIGN="LEFT" PORT="route_no"><FONT FACE="DejaVu Sans Mono">∗ </FONT>route_no</TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT FACE="DejaVu Sans Mono">∗ </FONT>status</TD></TR><TR><TD ALIGN="LEFT" PORT="scheduled_departure"><FONT FACE="DejaVu Sans Mono">∗ </FONT>scheduled_departure</TD></TR><TR><TD ALIGN="LEFT" PORT="scheduled_arrival"><FONT FACE="DejaVu Sans Mono">∗ </FONT>scheduled_arrival</TD></TR><TR><TD ALIGN="LEFT" PORT="actual_departure"><FONT FACE="DejaVu Sans Mono">○ </FONT>actual_departure</TD></TR><TR><TD ALIGN="LEFT" PORT="actual_arrival"><FONT FACE="DejaVu Sans Mono">○ </FONT>actual_arrival</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
  }
  subgraph "cluster_sales" {
    label=<<B>Продажи</B>>;
    style="rounded,filled"; fillcolor="#ececec"; color="#bbbbbb"; margin=14;
    "bookings" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>bookings</B><BR/>Бронирования</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="book_ref"><FONT FACE="DejaVu Sans Mono"># </FONT>book_ref</TD></TR><TR><TD ALIGN="LEFT" PORT="book_date"><FONT FACE="DejaVu Sans Mono">∗ </FONT>book_date</TD></TR><TR><TD ALIGN="LEFT" PORT="total_amount"><FONT FACE="DejaVu Sans Mono">∗ </FONT>total_amount</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "tickets" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>tickets</B><BR/>Билеты</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="ticket_no"><FONT FACE="DejaVu Sans Mono"># </FONT>ticket_no</TD></TR><TR><TD ALIGN="LEFT" PORT="book_ref"><FONT FACE="DejaVu Sans Mono">∗ </FONT>book_ref</TD></TR><TR><TD ALIGN="LEFT" PORT="passenger_id"><FONT FACE="DejaVu Sans Mono">∗ </FONT>passenger_id</TD></TR><TR><TD ALIGN="LEFT" PORT="passenger_name"><FONT FACE="DejaVu Sans Mono">∗ </FONT>passenger_name</TD></TR><TR><TD ALIGN="LEFT" PORT="outbound"><FONT FACE="DejaVu Sans Mono">∗ </FONT>outbound</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "segments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>segments</B><BR/>Перелёты</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="ticket_no"><FONT FACE="DejaVu Sans Mono"># </FONT>ticket_no</TD></TR><TR><TD ALIGN="LEFT" PORT="flight_id"><FONT FACE="DejaVu Sans Mono"># </FONT>flight_id</TD></TR><TR><TD ALIGN="LEFT" PORT="fare_conditions"><FONT FACE="DejaVu Sans Mono">∗ </FONT>fare_conditions</TD></TR><TR><TD ALIGN="LEFT" PORT="price"><FONT FACE="DejaVu Sans Mono">∗ </FONT>price</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
    "boarding_passes" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#cfcfcf" CELLPADDING="6"><B>boarding_passes</B><BR/>Посадочные талоны</TD></TR><TR><TD CELLPADDING="1"></TD></TR><TR><TD ALIGN="LEFT" PORT="ticket_no"><FONT FACE="DejaVu Sans Mono"># </FONT>ticket_no</TD></TR><TR><TD ALIGN="LEFT" PORT="flight_id"><FONT FACE="DejaVu Sans Mono"># </FONT>flight_id</TD></TR><TR><TD ALIGN="LEFT" PORT="seat_no"><FONT FACE="DejaVu Sans Mono">∗ </FONT>seat_no</TD></TR><TR><TD ALIGN="LEFT" PORT="boarding_no"><FONT FACE="DejaVu Sans Mono">○ </FONT>boarding_no</TD></TR><TR><TD ALIGN="LEFT" PORT="boarding_time"><FONT FACE="DejaVu Sans Mono">○ </FONT>boarding_time</TD></TR><TR><TD CELLPADDING="1"></TD></TR></TABLE>>];
  }
  "airplanes":"airplane_code" -> "seats":"airplane_code";
  "airports":"airport_code" -> "routes":"departure_airport";
  "airports":"airport_code" -> "routes":"arrival_airport";
  "airplanes":"airplane_code" -> "routes":"airplane_code";
  "routes":"route_no" -> "flights":"route_no" [style=dashed];
  "bookings":"book_ref" -> "tickets":"book_ref";
  "tickets":"ticket_no" -> "segments":"ticket_no";
  "flights":"flight_id" -> "segments":"flight_id";
  "segments":"ticket_no" -> "boarding_passes":"ticket_no";
}
